---
import Calculator from '../components/home/Calculator.astro';
import Cta from '../components/home/Cta.astro';
import Hero from '../components/home/Hero.astro';
import LogoBand from '../components/home/LogoBand.astro';
import ProductTour from '../components/home/ProductTour.astro';
import Results from '../components/home/Results.astro';
import Faq from '../components/ui/Faq.astro';
import { HOME_FAQ } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// The page follows a buyer's questions: what is it, what does each product do, what would it save me, did it
// work for others, what about my objections, book. The questions sit right before the booking band. The
// problem itself is told on the About page.
// Neighbouring sections never share a ground: orange, surface, dark, surface, paper, dark, orange.
---

<BaseLayout watch>
  <Hero />
  <LogoBand />
  <ProductTour />
  <Calculator />
  <Results />
  <Faq items={HOME_FAQ} tone="dark" />
  <Cta />
</BaseLayout>
