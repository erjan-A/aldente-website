---
import AldoDemo from '../components/home/AldoDemo.astro';
import Analytics from '../components/home/Analytics.astro';
import CaseStudy from '../components/home/CaseStudy.astro';
import Connections from '../components/home/Connections.astro';
import Cta from '../components/home/Cta.astro';
import Hero from '../components/home/Hero.astro';
import LogoBand from '../components/home/LogoBand.astro';
import OrderStory from '../components/home/OrderStory.astro';
import Problem from '../components/home/Problem.astro';
import Products from '../components/home/Products.astro';
import Voices from '../components/home/Voices.astro';
import BaseLayout from '../layouts/BaseLayout.astro';

// Neighbouring sections never share a ground: dark, surface, orange, dark, surface, paper, dark, surface, paper, orange.
---

<BaseLayout>
  <Hero />
  <LogoBand />
  <Problem />
  <Products />
  <OrderStory tone="surface" />
  <CaseStudy />
  <Analytics />
  <Connections tone="surface" padTop>
    <AldoDemo bare title="Aldo in Slack." muted="Ask, assign, alert." lead="Ask it anything. Give it the work you repeat. Pick a tab, or let it run." />
  </Connections>
  <Voices />
  <Cta />
</BaseLayout>
