---
import { Image } from 'astro:assets';
import Card from '../components/ui/Card.astro';
import { CUSTOMER_LOGOS } from '../data/logos';
import { retina } from '../lib/images';
import Scheduler from '../components/site/Scheduler.astro';
import { COUNTER } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { demoIntent, titleParts } from '../lib/demo';

// The server renders the general demo; <demo-intent> swaps the copy for ?plan=… in the browser.
const intent = demoIntent('');
const heading = titleParts(intent);
---

<BaseLayout title="Book a live demo" description="See Aldente on your restaurants in 30 minutes. Pick a time that suits you, and we’ll show the workflows that matter to your team.">
  <section class="demo tone-dark" aria-labelledby="demo-title">
    <demo-intent class="container demo__grid">
      <div class="demo__head">
        <h1 id="demo-title" data-intent="title">{heading.claim}{' '}<span>{heading.muted}</span></h1>
        <p class="demo__lead" data-intent="lead">{intent.lead}</p>
      </div>

      <Card as="section" pad="none" radius="xl" class="demo__card" id="schedule" aria-labelledby="schedule-title">
        <Scheduler titleId="schedule-title" />
      </Card>

      <div class="demo__details">
        <figure class="demo__quote">
          <blockquote>“We used to eat most refund claims, because fighting one took twenty minutes. Now the evidence pack is ready before anyone asks.”</blockquote>
          <figcaption><b>Head of Off-Premise</b> · QSR chain</figcaption>
        </figure>

        <div class="demo__proof">
          <p class="demo__proof-line">
            <b>{COUNTER.label}</b> orders served across 200+ restaurant locations.
          </p>
          <ul class="demo__logos" role="list">
            {
              CUSTOMER_LOGOS.map((logo) => {
                const height = Math.round(logo.height * 0.5);
                return (
                  <li>
                    <Image src={logo.mono ?? logo.src} alt={logo.name} height={height} densities={retina(logo.mono ?? logo.src)} style={`height:${height}px`} />
                  </li>
                );
              })
            }
          </ul>
        </div>
      </div>
    </demo-intent>
  </section>
</BaseLayout>

<script>
  import '../scripts/demo-intent';
</script>

<style>
  .demo {
    padding-block: clamp(32px, 4vw, 56px) var(--section-y);
  }

  /* Phones: heading and lead, then the calendar, then the details. */
  .demo__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'head'
      'card'
      'details';
    gap: 28px;
  }

  .demo__head {
    grid-area: head;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* The same title as every page hero; from 1024px it shares the row with the calendar, like a split PageHero. */
  h1 {
    max-width: 16ch;
    font-size: var(--step-h1);
    line-height: 1;
    letter-spacing: -0.04em;
    text-wrap: balance;
  }

  /* The span is rebuilt per plan by <demo-intent>, so it is styled through :global(). */
  h1 :global(span) {
    display: block;
    color: var(--fg-3);
    text-wrap: balance;
  }

  /* Phones: a step smaller, so "See Aldente Verify" (no-break space in the name) holds the first line
     instead of leaving "See" alone above it. 41px at 390, 38px at 360. */
  @media (max-width: 639px) {
    h1 {
      font-size: min(var(--step-h1), 10.6vw);
    }
  }

  .demo__lead {
    max-width: 44ch;
    font-size: var(--step-lead);
    line-height: 1.5;
    color: var(--fg-2);
    text-wrap: pretty;
  }

  /* ---------- Calendar card ---------- */

  .demo__card {
    grid-area: card;
  }

  /* ---------- Details: a voice and the proof ---------- */

  .demo__details {
    grid-area: details;
    display: flex;
    flex-direction: column;
    gap: 40px;
    margin-top: 12px;
  }

  .demo__quote {
    display: flex;
    flex-direction: column;
    gap: 12px;
    max-width: 46ch;
  }

  .demo__quote blockquote {
    font-size: var(--step-h4);
    font-weight: 500;
    line-height: 1.4;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .demo__quote figcaption {
    font-size: var(--step-small);
    color: var(--fg-3);
  }

  .demo__quote figcaption b {
    font-weight: 600;
    color: var(--fg-2);
  }

  .demo__proof {
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .demo__proof-line {
    max-width: 40ch;
    font-size: var(--step-small);
    color: var(--fg-2);
  }

  .demo__proof-line b {
    color: var(--fg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .demo__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 36px;
  }

  /* One light tone for every brand, as in the home proof bar. */
  .demo__logos img {
    width: auto;
    max-width: none;
    filter: brightness(0) invert(1);
    opacity: 0.55;
  }

  /* ---------- Desktop: intro and details left, the calendar card right and in view. ---------- */

  @media (min-width: 1024px) {
    .demo__grid {
      /* The card stays under 640px wide: wider, Calendly switches to a layout with its own bordered card. */
      grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
      grid-template-rows: auto 1fr;
      grid-template-areas:
        'head card'
        'details card';
      column-gap: clamp(48px, 5vw, 88px);
      row-gap: 48px;
      align-items: start;
    }

    .demo__head {
      padding-top: 16px;
      gap: 20px;
    }

    h1 {
      font-size: var(--step-h1-split);
    }

    .demo__card {
      position: sticky;
      top: calc(var(--header-h) + 24px);
    }

    .demo__details {
      margin-top: 0;
    }
  }
</style>
