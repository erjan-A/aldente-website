---
import CaseStudy from '../components/home/CaseStudy.astro';
import Cta from '../components/home/Cta.astro';
import OrderStory from '../components/home/OrderStory.astro';
import DisputeRecover from '../components/product/DisputeRecover.astro';
import VerifyHeroMedia from '../components/product/VerifyHeroMedia.astro';
import VerifyLoops from '../components/product/VerifyLoops.astro';
import PageHero from '../components/site/PageHero.astro';
import Button from '../components/ui/Button.astro';
import Card from '../components/ui/Card.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { LINKS } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

const tiles = [
  ['Verified orders', 'Every bag checked, by location and shift'],
  ['Wrong orders caught', 'What was missing, and where'],
  ['Disputes won', 'Refund claims answered with video'],
  ['Recovered revenue', 'Money back from delivery platforms'],
  ['Complaint reasons', 'Timing, portions, missing items'],
  ['Skipped checks', 'Stations where verification was bypassed'],
];
---

<BaseLayout title="Aldente Verify, order verification for restaurants" description="Aldente Verify checks every bag before pickup and wins back delivery refunds with video: a camera at the packing station, the packing clip for every claim.">
  <PageHero
    product="verify"
    title="Verify checks every bag before pickup"
    muted="and wins back refunds with video."
    lead="A camera at the packing station checks every item against the POS order before pickup. When a delivery app still charges a refund, Aldente disputes it with the packing clip."
  >
    <Button href={`${LINKS.demo}?plan=verification`} size="lg" arrow>Book a demo</Button>
    <Button href={LINKS.pricing} variant="secondary" size="lg">Compare plans</Button>
    <VerifyHeroMedia slot="media" />
  </PageHero>
  <VerifyLoops />
  <OrderStory title="How an order" muted="is verified." product={null} />
  <DisputeRecover />
  <CaseStudy />
  <section class="tone-dark section" aria-labelledby="dash-title">
    <div class="container dash">
      <SectionHeader
        id="dash-title"
        title="Accuracy for every location,"
        muted="in real time."
        lead="See verified orders, wrong orders caught, disputes won and money recovered by location. Find the stations where checks are skipped and fix them with training."
      />
      <ul class="dash__tiles" role="list">
        {
          tiles.map(([name, detail]) => (
            <Card as="li" class="dash__tile">
              <span class="dash__name">{name}</span>
              <span class="dash__detail">{detail}</span>
            </Card>
          ))
        }
      </ul>
      <Card class="dash__catering">
        <h3>Built for catering too</h3>
        <p>A 30-item catering order can lose track in the bags. Check trays from the tablet or the phone app and log the handover.</p>
      </Card>
    </div>
  </section>
  <Cta title="Catch the next wrong order before it leaves." text="See Aldente Verify in a 30-minute demo." plan="verification" />
</BaseLayout>

<style>
  .dash {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  /* Six tiles: one column on phones (like /security), 2 x 3 on tablets, 3 x 2 on wide screens. */
  .dash__tiles {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  @media (min-width: 640px) {
    .dash__tiles {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .dash__tiles :global(.dash__tile) {
    --card-gap: 8px;
  }

  .dash__name {
    font-size: var(--step-h4);
    font-weight: 600;
    line-height: 1.2;
    letter-spacing: -0.015em;
  }

  .dash__detail {
    font-size: var(--step-small);
    color: var(--fg-3);
  }

  @media (min-width: 900px) {
    .dash__tiles {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }
  }

  .dash :global(.dash__catering) {
    flex-direction: row;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 16px 48px;
  }

  .dash :global(.dash__catering) h3 {
    font-size: var(--step-h3);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .dash :global(.dash__catering) p {
    max-width: 52ch;
    color: var(--fg-2);
  }
</style>
