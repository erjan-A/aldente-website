---
import Cta from '../components/home/Cta.astro';
import Problem from '../components/home/Problem.astro';
import Voices from '../components/home/Voices.astro';
import PageHero from '../components/site/PageHero.astro';
import Icon from '../components/ui/Icon.astro';
import { SITE } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="About us" description="Aldente AI builds vision AI for restaurant orders: every order checked before pickup, every refund claim answered with proof, every order rung up while staff build it.">
  <PageHero
    title="Restaurants lose money at the counter,"
    muted="so that is where we put the camera."
    lead="We are restaurant operators and engineers. We build vision AI that checks every order before pickup, answers every refund claim with proof and rings up orders while staff build them."
  >
    <p class="based"><Icon name="map-pin" size={18} />Based in Los Angeles</p>
  </PageHero>
  <section class="tone-dark stats-wrap" aria-label="Aldente so far">
    <div class="container">
      <p class="stats">
        Today Aldente runs in <b>200+ restaurant locations</b> and has served <b>more than 2 million orders</b>. At one location it cut wrong orders by <b>87%</b>.
      </p>
    </div>
  </section>
  {/* Why we started: the refund problem and its numbers (on the home page until 2026-11-16). */}
  <Problem />
  <Voices team />
  <section class="tone-dark section careers" aria-labelledby="careers-title">
    <div class="container careers__inner">
      <h2 id="careers-title">Join us.</h2>
      <p>We’re hiring engineers and operators who want to change how restaurants run. Write to <a href={`mailto:${SITE.email}?subject=Careers`}>{SITE.email}</a>.</p>
    </div>
  </section>
  <Cta />
</BaseLayout>

<style>
  .based {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--fg-2);
  }

  .based :global(svg) {
    color: var(--accent);
  }

  .stats-wrap {
    padding-bottom: var(--section-y);
  }

  /* The rule sits on the text column, inside the container's gutter. */
  .stats {
    padding-top: 32px;
    border-top: 1px solid var(--line);
    font-size: var(--step-statement);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.02em;
    color: var(--ink-2);
    text-wrap: pretty;
  }

  .stats b {
    color: var(--ink);
    font-weight: 700;
  }

  .careers__inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: baseline;
    gap: 24px;
  }

  /* Same title and lead as SectionHeader; the lead holds a link, so it is written out here. */
  .careers h2 {
    font-size: var(--step-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
  }

  .careers p {
    max-width: 48ch;
    font-size: var(--step-lead);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .careers a {
    color: var(--ink);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
</style>
