---
import AldoDemo from '../components/home/AldoDemo.astro';
import Analytics from '../components/home/Analytics.astro';
import Connections from '../components/home/Connections.astro';
import Cta from '../components/home/Cta.astro';
import Playbooks from '../components/home/Playbooks.astro';
import AldoHeroMedia from '../components/product/AldoHeroMedia.astro';
import HowWeStart from '../components/site/HowWeStart.astro';
import PageHero from '../components/site/PageHero.astro';
import Button from '../components/ui/Button.astro';
import Faq from '../components/ui/Faq.astro';
import SectionHeader from '../components/ui/SectionHeader.astro';
import { LINKS } from '../data/site';
import BaseLayout from '../layouts/BaseLayout.astro';

// Aldente Playbooks is the former Aldo and Aldente Vision as one product. Aldo stays as the name of the
// assistant in Slack. The page follows the work: ask in Slack, save it as a Playbook, see what the cameras read.
const abilities = [
  { title: 'Ask anything about any location', text: 'Type or say a question in Slack. Aldo checks your cameras, orders and staff records and answers with the source attached.' },
  { title: 'Every answer shows its source', text: 'Aldo links each answer to the clip, frame or record behind it, so your team can check before they act.' },
  { title: 'The right person hears first', text: 'Route each event to the person who can act: the shift lead, the district manager, or HR. Every alert carries the location, the time and the camera view.' },
  { title: 'Say it out loud', text: 'Send Aldo a voice note from the floor. It turns the request into a question or a Playbook and confirms what it heard.' },
  { title: 'Compare every location', text: 'Peak-hour heatmaps, leaderboards and week-over-week trends show which locations need help and which ones to learn from.' },
  { title: 'Lives where your team already works', text: 'Slack, Telegram, WhatsApp, voice, or the web dashboard. No new app to learn.' },
];

const demoPlan = 'starter';

const faq = [
  { q: 'What can Aldo see?', a: 'Whatever your connected cameras see, plus your orders, staff and other connected records.' },
  { q: 'Do I need new cameras?', a: 'No. Aldente Playbooks works with most existing IP cameras.' },
  { q: 'What counts as a Playbook?', a: 'One saved task with its schedule or trigger. Questions are unlimited on every plan.' },
  { q: 'Can I control who gets which alerts?', a: 'Yes. Each Playbook names its channel or person, and access follows roles and locations.' },
  { q: 'Does it know who the guests are?', a: 'No. It counts new and returning guests without names attached.' },
];
---

<BaseLayout
  title="Aldente Playbooks, your cameras in Slack"
  description="Ask a question in Slack and your cameras answer. Tell Aldo what to watch once, and it runs as a Playbook at every location, every shift."
>
  <PageHero
    product="playbooks"
    title="Ask once in Slack,"
    muted="and it runs every shift."
    lead="Aldente Playbooks reads the cameras you already have. Ask Aldo a question in Slack, or tell it what to watch: it saves the task as a Playbook and runs it at every location."
  >
    <Button href={`${LINKS.demo}?plan=${demoPlan}`} size="lg" arrow>Book a live demo</Button>
    <Button href="#aldo" variant="secondary" size="lg">See Aldo in action</Button>
    <AldoHeroMedia slot="media" />
  </PageHero>
  <AldoDemo title="Aldo in Slack." muted="Ask, assign, alert." lead="Ask it anything. Give it the work you repeat. Pick a tab, or let it run." product={null} padTop />
  <Playbooks product={null} title="Say it once," muted="and it becomes a Playbook." />
  <Analytics
    title="What the cameras read,"
    muted="by location and hour."
    lead="Vision AI finds the people, tables and queues on each camera. Every event adds up to the numbers Aldo answers with."
  />
  <section class="abilities tone-surface section" aria-labelledby="abilities-title">
    <div class="container abilities__inner">
      <SectionHeader id="abilities-title" title="One colleague," muted="every location, every shift." />
      <ul class="abilities__grid" role="list">
        {
          abilities.map((a) => (
            <li>
              <h3>{a.title}</h3>
              <p>{a.text}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </section>
  <Connections padTop product={null} />
  <HowWeStart tone="surface" />
  <Faq items={faq} tone="dark" />
  <Cta title="Put Aldo on your next shift." text="See Aldente Playbooks in a 30-minute demo, with questions like yours." plan={demoPlan} />
</BaseLayout>

<style>
  .abilities__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  /* One panel ruled into cells: the 1px gaps show the card edge colour between the cells. */
  .abilities__grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(340px, 100%), 1fr));
    gap: 1px;
    border: 1px solid var(--card-line);
    border-radius: var(--radius-l);
    background: var(--card-line);
    overflow: hidden;
  }

  .abilities__grid li {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--card-pad-l);
    background: var(--card);
  }

  .abilities__grid h3 {
    font-size: var(--step-h4);
    line-height: 1.2;
    letter-spacing: -0.015em;
    font-weight: 600;
  }

  .abilities__grid p {
    color: var(--fg-2);
  }
</style>
