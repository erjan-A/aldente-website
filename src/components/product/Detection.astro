---
/**
 * One detection box drawn over a camera frame or a packing photo, in the home console's language:
 * a 2px box in the tone colour and a solid label.
 *   tone   alert (orange, needs a person) | ok (green, checked or staffed) | neutral (white, information)
 *   box    position and size in % of the frame: [left, top, width, height]
 *   place  where the label sits: inside the box (top left), or outside it, above or below its start
 * Decorative: the frame's own alt text or caption carries the meaning.
 */
interface Props {
  tone?: 'alert' | 'ok' | 'neutral';
  label: string;
  box: readonly [number, number, number, number];
  place?: 'inside' | 'top-start' | 'bottom-start';
  class?: string;
}

const { tone = 'ok', label, box, place = 'top-start', class: className } = Astro.props;
const [left, top, width, height] = box;
---

<span
  class:list={['det', `det--${tone}`, `det--${place}`, className]}
  style={`left:${left}%;top:${top}%;width:${width}%;height:${height}%`}
  aria-hidden="true"
>
  <span class="det__label">{label}</span>
</span>

<style>
  .det {
    position: absolute;
    border: 2px solid var(--det);
    border-radius: var(--radius-s);
  }

  .det--alert {
    --det: var(--accent);
    --det-ink: var(--on-accent);
    background: color-mix(in srgb, var(--accent) 14%, transparent);
  }

  .det--ok {
    --det: var(--ok);
    --det-ink: var(--on-accent);
  }

  .det--neutral {
    --det: var(--ink);
    --det-ink: var(--bg);
  }

  .det__label {
    position: absolute;
    display: inline-flex;
    align-items: center;
    padding: 3px 7px;
    border-radius: var(--radius-xs);
    background: var(--det);
    color: var(--det-ink);
    font-size: var(--step-mock);
    font-weight: 700;
    line-height: 1.25;
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .det--inside .det__label {
    left: 6px;
    top: 6px;
  }

  .det--top-start .det__label {
    bottom: calc(100% + 4px);
  }

  .det--bottom-start .det__label {
    top: calc(100% + 4px);
  }

  .det--top-start .det__label,
  .det--bottom-start .det__label {
    left: -2px;
  }
</style>
