---
import { Image } from 'astro:assets';
import trayComplete from '../../assets/images/order-tray-complete.jpg';
import Icon from '../ui/Icon.astro';
import Detection from './Detection.astro';

/**
 * /order-verification hero: the Aldente Verify tablet on its stand at the packing station, showing order
 * #4821 after the fix. The wording follows OrderStory: the first check at 12:40 asked for one more drink,
 * the second verified the bag at 12:41.
 */
const items = [
  { name: 'Turkey sandwich', count: '1/1' },
  { name: 'Fries', count: '1/1' },
  { name: 'Drinks', count: '2/2', flag: { time: '12:40', text: 'Add 1 drink' } },
];

// Boxes on the packing photo, in % of the frame: [left, top, width, height].
const boxes = [
  { label: 'Sandwich', box: [2, 30, 57, 58] },
  { label: 'Fries', box: [55, 4, 30, 46] },
  { label: 'Drink 1', box: [68, 38, 30, 52] },
  { label: 'Drink 2 added', box: [13, 1, 23, 28] },
] as const;
---

<figure class="vh">
  <div class="vh__tablet">
    <div class="vh__screen">
      <div class="vh__bar">
        <span class="vh__app"><Icon name="check-check" size={14} strokeWidth={2.25} />Packing station</span>
        <span>Location 01</span>
      </div>
      <div class="vh__body">
        <div class="vh__photo">
          <div class="vh__frame">
            <Image
              src={trayComplete}
              alt="Packing photo of order 4821: a turkey sandwich, fries and two drinks, each outlined as detected"
              widths={[400, 640, 960]}
              sizes="(min-width: 1024px) 440px, 90vw"
              loading="eager"
              fetchpriority="high"
            />
            {boxes.map((b) => <Detection tone="ok" label={b.label} box={b.box} place="inside" class="vh__det" />)}
          </div>
        </div>
        <div class="vh__order">
          <p class="vh__head"><b>#4821</b><span>Delivery</span></p>
          <ul class="vh__items" role="list">
            {
              items.map((item) => (
                <li class:list={['vh__item', { 'vh__item--flag': item.flag }]}>
                  <span class="vh__name">{item.name}</span>
                  <b class="vh__count">
                    {item.count}
                    <Icon name="check" size={14} strokeWidth={3} />
                  </b>
                  {
                    item.flag && (
                      <span class="vh__flag">
                        <time>{item.flag.time}</time> {item.flag.text}
                      </span>
                    )
                  }
                </li>
              ))
            }
          </ul>
          <p class="vh__status"><Icon name="check" size={16} strokeWidth={3} />Verified <time>12:41</time></p>
        </div>
      </div>
    </div>
  </div>
  <div class="vh__stand" aria-hidden="true"><i></i></div>
  <figcaption class="visually-hidden">
    Aldente Verify at the packing station: order 4821 checked against the POS. The first check at 12:40 asked for one more drink; the
    second verified the bag at 12:41.
  </figcaption>
</figure>

<style>
  .vh {
    margin: 0;
    container-type: inline-size;
  }

  /* The device: a dark bezel with a camera dot, a soft drop shadow, and a stand below. The bezel is the
     difference between the two radii (xl 32 - m 16), so the screen's corners run parallel to the frame's. */
  .vh__tablet {
    position: relative;
    padding: 16px;
    border-radius: var(--radius-xl);
    background: var(--surface-2);
    border: 1px solid var(--line-strong);
    box-shadow: 0 40px 80px -40px rgb(0 0 0 / 0.9);
  }

  .vh__tablet::before {
    content: '';
    position: absolute;
    left: 50%;
    top: 6px;
    width: 4px;
    height: 4px;
    border-radius: 50%;
    background: var(--line-strong);
    translate: -50% 0;
  }

  .vh__stand {
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .vh__stand i {
    width: 18%;
    height: 26px;
    background: linear-gradient(180deg, var(--surface-2), var(--surface));
    clip-path: polygon(22% 0, 78% 0, 100% 100%, 0 100%);
  }

  .vh__stand::after {
    content: '';
    width: 44%;
    height: 6px;
    border-radius: var(--radius-pill);
    background: var(--surface-2);
    border-top: 1px solid var(--line-strong);
  }

  .vh__screen {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 12px;
    border-radius: var(--radius-m);
    background: var(--bg);
    overflow: hidden;
  }

  .vh__bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    padding: 0 4px;
    font-size: var(--step-label);
    color: var(--ink-3);
  }

  .vh__app {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ink);
    font-weight: 600;
  }

  .vh__app :global(svg) {
    color: var(--ok);
  }

  .vh__body {
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  /* The photo cell can take any shape; the 4:3 frame inside covers it, so the boxes stay on their items. */
  .vh__photo {
    position: relative;
    container-type: size;
    aspect-ratio: 4 / 3;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: var(--surface-2);
  }

  .vh__frame {
    position: absolute;
    left: 50%;
    top: 50%;
    width: max(100cqw, 133.34cqh);
    aspect-ratio: 4 / 3;
    translate: -50% -50%;
  }

  .vh__frame img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .vh__order {
    display: flex;
    flex-direction: column;
    gap: 10px;
    min-width: 0;
  }

  .vh__head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px;
    padding: 0 4px;
  }

  .vh__head b {
    font-size: var(--step-body);
    font-variant-numeric: tabular-nums;
    font-weight: 700;
  }

  .vh__head span {
    font-size: var(--step-label);
    color: var(--ink-3);
  }

  .vh__items {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .vh__item {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto auto;
    align-items: center;
    gap: 6px 10px;
    padding: 9px 12px;
    border-radius: var(--radius-s);
    background: var(--surface);
    font-size: var(--step-small);
  }

  .vh__name {
    min-width: 0;
    line-height: 1.25;
  }

  .vh__count {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--ok);
    font-variant-numeric: tabular-nums;
  }

  /* The drinks row keeps the first check's flag, so the catch stays visible after the fix. */
  .vh__item--flag {
    box-shadow: inset 0 0 0 1px rgb(224 86 52 / 0.45);
  }

  .vh__flag {
    grid-column: 2;
    grid-row: 1;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 1px 7px;
    border-radius: var(--radius-xs);
    border: 1px solid var(--accent);
    color: var(--accent);
    font-size: var(--step-label);
    font-weight: 600;
  }

  /* Times in Onest with tabular figures, as in the Order Story ticket. */
  .vh__flag time,
  .vh__status time {
    font-variant-numeric: tabular-nums;
  }

  .vh__status {
    margin-top: auto;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    min-height: 44px;
    padding: 0 12px;
    border-radius: var(--radius-s);
    background: var(--ok);
    color: var(--on-accent);
    font-weight: 700;
  }

  /* Wide enough for the tablet in landscape: photo left, order right. The row takes the order's height. */
  @container (min-width: 560px) {
    .vh__body {
      display: grid;
      grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    }

    /* The photo keeps its 4:3 shape, so no detection label at the frame's edge is cropped. */
    .vh__photo {
      align-self: center;
    }

    .vh__item {
      padding-block: 7px;
    }

    .vh__flag {
      grid-column: 1 / -1;
      grid-row: 2;
      justify-self: start;
    }
  }

  @container (max-width: 380px) {
    .vh__tablet {
      padding: 8px;
      border-radius: var(--radius-l);
    }

    .vh__screen {
      padding: 10px;
    }

    .vh :global(.vh__det .det__label) {
      font-size: 0.6875rem;
      padding: 2px 5px;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .vh :global(.vh__det) {
      animation: vh-box 0.5s var(--ease-out) both;
    }

    .vh :global(.vh__det:nth-of-type(2)) {
      animation-delay: 0.08s;
    }

    .vh :global(.vh__det:nth-of-type(3)) {
      animation-delay: 0.16s;
    }

    .vh :global(.vh__det:nth-of-type(4)) {
      animation-delay: 0.24s;
    }

    .vh__status {
      animation: vh-status 0.5s var(--ease-out) 0.45s both;
    }
  }

  @keyframes vh-box {
    from {
      opacity: 0;
      scale: 1.06;
    }
  }

  @keyframes vh-status {
    from {
      opacity: 0;
      translate: 0 6px;
    }
  }
</style>
