---
import '../../styles/slack.css';
import Icon from '../ui/Icon.astro';

interface Props {
  /** Channel shown first. */
  active: string;
  /** Text for the composer; defaults to "Message #channel". */
  composer?: string;
  label?: string;
  class?: string;
}

const { active, composer, label = 'Aldo in Slack', class: className } = Astro.props;
---

<figure class:list={['slack', 'slack-window', className]} aria-label={label}>
  <div class="slack-window__body">
    <div class="slack-window__main">
      <div class="slack-window__header">
        <span class="slack-window__channel"><Icon name="hash" size={16} /><span data-slack-channel>{active}</span></span>
      </div>
      <div class="slack-window__messages">
        <slot />
      </div>
      <div class="slack-window__composer" aria-hidden="true">
        <span data-slack-composer>{composer ?? `Message #${active}`}</span>
        <span class="slack-window__tools"><Icon name="plus" size={16} /><Icon name="mic" size={16} /></span>
      </div>
    </div>
  </div>
</figure>

<style>
  .slack-window {
    margin: 0;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-m);
    overflow: hidden;
    background: #ffffff;
    border: 1px solid var(--line-card);
    min-width: 0;
  }

  .slack-window__body {
    display: flex;
    flex: 1;
    min-height: 0;
  }

  .slack-window__main {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    background: #ffffff;
  }

  .slack-window__header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
    height: 49px;
    padding: 0 16px;
    border-bottom: 1px solid var(--slack-border);
  }

  .slack-window__channel {
    display: flex;
    align-items: center;
    gap: 2px;
    font-size: 18px;
    font-weight: 900;
    color: var(--slack-text);
  }

  .slack-window__messages {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 0;
  }

  /* New messages sit at the bottom, above the composer, as in Slack. */
  .slack-window__messages > :global(:first-child) {
    margin-top: auto;
  }

  .slack-window__composer {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin: 0 16px 16px;
    padding: 11px 12px;
    border: 1px solid #bbbabb;
    border-radius: var(--radius-s);
    color: #616061;
    font-size: 15px;
  }

  .slack-window__tools {
    display: flex;
    gap: 10px;
  }
</style>
