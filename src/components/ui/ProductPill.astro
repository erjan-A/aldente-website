---
import { PRODUCTS, type ProductId } from '../../data/products';
import Icon, { type IconName } from './Icon.astro';

/**
 * The label over a section title, as on every deck slide. With `product`: the product's name and its icon;
 * `label` can rename it ("Aldo in Slack"). Without `product`: a plain topic pill ("Customer results"), which
 * may carry an icon of its own ("For restaurant chains" in the home hero).
 */
type Props = { product: ProductId; label?: string; icon?: undefined } | { product?: undefined; label: string; icon?: IconName };

const { product, label, icon } = Astro.props;
const meta = product ? PRODUCTS[product] : undefined;
---

<span class:list={['pill', product && `pill--${product}`, { 'pill--plain': !product && !icon }]}>
  {
    meta && <Icon name={meta.icon} size={14} />
  }
  {icon && <Icon name={icon} size={14} />}
  {label ?? meta?.name}
</span>

<style>
  /* Product label: names the product a section belongs to. Neutral pill, one orange cue. Tone-aware. */
  .pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 12px 0 8px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--card-line, var(--line-card));
    background: var(--card, var(--surface));
    color: var(--fg, var(--ink));
    font-size: var(--step-label);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .pill--plain {
    padding: 0 12px;
  }

  /* On the orange ground: a dark wash under the white hairline, so the small white label keeps AA (4.5:1)
     on the lightest part of the gradient too. */
  :global(.tone-orange) .pill {
    background: rgb(0 0 0 / 0.24);
  }

  .pill :global(svg) {
    flex: none;
    color: var(--accent);
  }

  /* On orange the accent would vanish into the ground: the icon takes the ink. */
  :global(.tone-orange) .pill :global(svg) {
    color: var(--fg);
  }

</style>
