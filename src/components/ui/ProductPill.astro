---
import mark from '../../assets/logos/aldente-mark.svg';
import { PRODUCTS, type ProductId } from '../../data/products';
import Icon from './Icon.astro';

/**
 * The label over a section title, as on every deck slide. With `product`: the product's name and cue (Aldente
 * Verify's check, Aldente Vision's eye, Aldo's avatar); `label` can rename it ("Aldo in Slack"). Without
 * `product`: a plain topic pill ("Customer results").
 */
type Props = { product: ProductId; label?: string } | { product?: undefined; label: string };

const { product, label } = Astro.props;
const meta = product ? PRODUCTS[product] : undefined;
---

<span class:list={['pill', product && `pill--${product}`, { 'pill--plain': !product }]}>
  {
    meta &&
      (meta.icon ? (
        <Icon name={meta.icon} size={14} strokeWidth={2.25} />
      ) : (
        <span class="pill__avatar" aria-hidden="true">
          <img src={mark.src} alt="" width="9" height="11" />
        </span>
      ))
  }
  {label ?? meta?.name}
</span>

<style>
  /* Product label: names the product a section belongs to. Neutral pill, one orange cue. Tone-aware. */
  .pill {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    height: 30px;
    padding: 0 13px 0 9px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--card-line, var(--line-card));
    background: var(--card, var(--surface));
    color: var(--fg, var(--ink));
    font-size: var(--step-label);
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
  }

  .pill--plain {
    padding: 0 13px;
  }

  /* On the orange ground: a white wash with a white hairline, as the decks do. */
  :global(.tone-orange) .pill {
    background: rgb(255 255 255 / 0.12);
  }

  .pill :global(svg) {
    flex: none;
    color: var(--accent);
  }

  /* Aldo shows its Slack avatar. */
  .pill__avatar {
    flex: none;
    width: 18px;
    height: 18px;
    border-radius: var(--radius-xs);
    background: #0b0b0b;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pill__avatar img {
    width: 9px;
    height: auto;
  }
</style>
