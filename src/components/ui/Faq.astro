---
import { LINKS, SITE } from '../../data/site';
import Icon from './Icon.astro';
import SectionHeader from './SectionHeader.astro';

interface Props {
  items: { q: string; a: string }[];
  title?: string;
  /** The quieter end of the heading, as on every section heading. */
  muted?: string;
  tone?: 'paper' | 'dark';
}

const { items, title = 'Before you book,', muted = 'the usual questions.', tone = 'paper' } = Astro.props;
---

<section class:list={['faq', 'section', `tone-${tone}`]} aria-labelledby="faq-title">
  <div class="container faq__inner">
    <SectionHeader id="faq-title" label="FAQ" title={title} muted={muted} />
    <div class="faq__body">
      <div class="faq__list">
        {
          items.map((item) => (
            <details>
              <summary>
                {item.q}
                <span class="faq__plus" aria-hidden="true"><Icon name="plus" size={20} /></span>
              </summary>
              <p>{item.a}</p>
            </details>
          ))
        }
      </div>
      <p class="faq__more">
        Something else? Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a>, call <a href={SITE.phoneHref} class="nowrap">{SITE.phone}</a> or{' '}
        <a href={LINKS.demo}>book a live demo</a>.
      </p>
    </div>
  </div>
</section>

<style>
  /* The same header as every section, the questions under it, and the way to ask something else beside them. */
  .faq__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .faq__body {
    display: grid;
    gap: 32px;
  }

  @media (min-width: 960px) {
    .faq__body {
      grid-template-columns: minmax(0, 2fr) minmax(0, 1fr);
      gap: 80px;
      align-items: start;
    }
  }

  .faq__more {
    color: var(--fg-2);
    text-wrap: pretty;
  }

  .faq__more a {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .faq__list {
    border-top: 1px solid var(--card-line);
  }

  details {
    border-bottom: 1px solid var(--card-line);
  }

  summary {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 24px 0;
    font-size: var(--step-h4);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
    list-style: none;
    cursor: pointer;
  }

  summary::-webkit-details-marker {
    display: none;
  }

  .faq__plus {
    flex: none;
    /* Centred on the first line of the question. */
    margin-top: calc((1.35em - 20px) / 2);
    color: var(--accent);
    transition: transform 0.2s ease;
  }

  details[open] .faq__plus {
    transform: rotate(45deg);
  }

  details p {
    max-width: 62ch;
    padding-bottom: 24px;
    color: var(--fg-2);
  }
</style>
