---
import type { ProductId } from '../../data/products';
import ProductPill from './ProductPill.astro';

/**
 * Section heading block. Title is an h2 in --step-h2, lead uses --step-lead.
 * Layouts: split and stack (the lead under the title, as wide as the title).
 */
interface Props {
  /** Which product the section belongs to, shown as a pill above the title. */
  product?: ProductId;
  /** The pill's text: a topic on its own ("Customer results"), or a product's own wording ("Aldo in Slack"). */
  label?: string;
  /** The claim, in full ink. */
  title: string;
  /** The continuation, in muted ink. */
  muted?: string;
  lead?: string;
  layout?: 'split' | 'stack';
  id?: string;
}

const { product, label, title, muted, lead, layout = 'split', id } = Astro.props;
---

<header class:list={['head', `head--${layout}`]}>
  <div class="head__titles">
    {product ? <ProductPill product={product} label={label} /> : label && <ProductPill label={label} />}
    <h2 class="head__title" id={id}>
      {title}{muted && <> <span class="head__muted">{muted}</span></>}
    </h2>
  </div>
  {lead && <p class="head__lead">{lead}</p>}
</header>

<style>
  /* The title sets the block's width (fit-content); the lead takes exactly that width (width 0, min-width
     100%), so title and subtitle line up on both edges. A short title still gives the lead at least 36rem. */
  .head {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: fit-content;
    min-width: min(100%, 36rem);
    max-width: 100%;
  }

  .head__titles {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* Two lines at most from about 1000px: wide enough for the longest titles, and balanced, so a short
     title still breaks into two even lines instead of one long one. */
  .head__title {
    max-width: 18em;
    font-size: var(--step-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    color: var(--fg);
    text-wrap: balance;
  }

  .head__muted {
    color: var(--fg-3);
  }

  /* The claim, then its continuation on a line of its own, at every width: never a grey word hanging at the
     end of the claim. Each half stays balanced. */
  .head__muted {
    display: block;
    text-wrap: balance;
  }

  .head__lead {
    width: 0;
    min-width: 100%;
    font-size: var(--step-lead);
    line-height: 1.5;
    color: var(--fg-2);
    text-wrap: pretty;
  }

</style>
