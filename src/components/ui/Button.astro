---
import type { HTMLAttributes } from 'astro/types';
import Icon from './Icon.astro';

/**
 * A link styled as a button. Variants:
 *   primary    orange fill. Booking actions ONLY: "Book a demo", "Talk to us".
 *   secondary  outline in --line-strong, for the second action on dark grounds.
 *   dark       near-black fill, for actions on orange and paper grounds.
 *   outline    currentColor edge, tone-aware (any ground).
 *   link       text link with an arrow, --fg-accent on hover. For "Compare plans", "How Verify works" etc.
 * Sizes (all at least 44px tall): sm 44px (header, compact rows), md 48px (default), lg 56px (heroes, CTA bands).
 * Extra attributes (data-*, aria-*, id, download…) pass through to the <a>.
 */
interface Props extends Omit<HTMLAttributes<'a'>, 'href'> {
  href: string;
  variant?: 'primary' | 'secondary' | 'dark' | 'outline' | 'link';
  size?: 'sm' | 'md' | 'lg';
  /** Trailing arrow. Defaults to true for variant "link", false otherwise. */
  arrow?: boolean;
  class?: string;
}

const { href, variant = 'primary', size = 'md', arrow = variant === 'link', class: className, ...rest } = Astro.props;
const external = /^https?:\/\//.test(href);
---

<a
  class:list={['btn', `btn--${variant}`, `btn--${size}`, className]}
  href={href}
  target={external ? '_blank' : undefined}
  rel={external ? 'noopener' : undefined}
  {...rest}
>
  <slot />
  {arrow && <Icon name="arrow-right" size={size === 'sm' ? 16 : 18} strokeWidth={2} class="btn__arrow" />}
</a>

<style>
  .btn {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    min-height: 48px;
    padding: 0 22px;
    border-radius: var(--radius-pill);
    border: 1.5px solid transparent;
    font-size: 1rem;
    font-weight: 600;
    line-height: 1;
    white-space: nowrap;
    transition:
      transform 0.2s var(--ease-out),
      background-color 0.2s ease,
      border-color 0.2s ease,
      color 0.2s ease;
  }

  .btn--sm {
    gap: 8px;
    min-height: 44px;
    padding: 0 18px;
    font-size: var(--step-small);
  }

  .btn--lg {
    min-height: 56px;
    padding: 0 28px;
    font-size: var(--step-body);
  }

  .btn:hover {
    transform: translateY(-2px);
  }

  .btn:active {
    transform: translateY(0);
  }

  .btn :global(.btn__arrow) {
    flex: none;
    transition: transform 0.2s var(--ease-out);
  }

  .btn:hover :global(.btn__arrow) {
    transform: translateX(3px);
  }

  /* A soft top-lit gradient on the logo orange, painted edge to edge (border-box) so no seam shows
     at the rim. Dark text keeps AA contrast across it; hover adds a warm glow instead of an edge. */
  .btn--primary {
    background: linear-gradient(180deg, #ec6a42 0%, #db4f2c 100%) border-box;
    color: var(--on-accent);
    transition:
      transform 0.2s var(--ease-out),
      box-shadow 0.2s ease;
  }

  .btn--primary:hover {
    background: linear-gradient(180deg, #f07650 0%, #e05634 100%) border-box;
    box-shadow: 0 12px 28px -12px rgb(224 86 52 / 0.7);
  }

  .btn--secondary {
    border-color: var(--line-strong);
    color: var(--fg, var(--ink));
  }

  .btn--secondary:hover {
    border-color: var(--fg, var(--ink));
  }

  :global(.tone-orange) .btn--secondary:not(:hover) {
    border-color: rgb(255 255 255 / 0.55);
  }

  /* For orange and paper grounds. */
  .btn--dark {
    background: var(--bg);
    color: var(--ink);
  }

  .btn--outline {
    border-color: currentColor;
    color: var(--fg, var(--ink));
  }

  /* Text link: no box, but the hit area stays 44px tall. Overrides the box rules above. */
  .btn--link {
    align-self: flex-start;
    justify-content: flex-start;
    gap: 8px;
    min-height: 44px;
    padding: 0;
    border: 0;
    border-radius: 0;
    color: var(--fg, var(--ink));
  }

  .btn--link:hover {
    transform: none;
    color: var(--fg-accent, var(--accent));
  }

  .btn--link:focus-visible {
    border-radius: var(--radius-xs);
  }

  :global(.tone-orange) .btn--link:hover {
    text-decoration: underline;
    text-underline-offset: 4px;
  }
</style>
