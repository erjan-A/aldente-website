---
import mark from '../../assets/logos/aldente-mark.svg';
import type { NavLink } from '../../data/site';
import Icon from '../ui/Icon.astro';

/**
 * One link in a header dropdown or the mobile menu: an icon tile, the label and its one-line note.
 * Products and solutions show their icon; Aldo, which has none, shows the Aldente mark (its Slack avatar).
 * The current page gets aria-current="page" and the accent underline under its label.
 */
interface Props {
  item: NavLink;
  current?: boolean;
}

const { item, current = false } = Astro.props;
---

<a class="nav-row" href={item.href} aria-current={current ? 'page' : undefined}>
  <span class="nav-row__tile" aria-hidden="true">
    {item.icon ? <Icon name={item.icon} size={18} strokeWidth={2} /> : <img src={mark.src} alt="" width="12" height="15" />}
  </span>
  <span class="nav-row__text">
    <span class="nav-row__label">{item.label}</span>
    {item.note && ' '}
    {item.note && <span class="nav-row__note">{item.note}</span>}
  </span>
</a>

<style>
  .nav-row {
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 60px;
    padding: 10px 12px;
    border-radius: var(--radius-s);
    color: var(--ink);
    transition: background-color 0.15s ease;
  }

  .nav-row:hover {
    background: var(--surface-2);
  }

  .nav-row__tile {
    flex: none;
    width: 36px;
    height: 36px;
    display: grid;
    place-items: center;
    border-radius: var(--radius-s);
    border: 1px solid var(--line-card);
    background: var(--bg);
    color: var(--accent);
  }

  .nav-row__tile img {
    width: 12px;
    height: auto;
  }

  .nav-row__text {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
  }

  .nav-row__label {
    position: relative;
    align-self: flex-start;
    font-size: var(--step-small);
    font-weight: 600;
    line-height: 1.3;
  }

  .nav-row__note {
    font-size: var(--step-label);
    line-height: 1.35;
    color: var(--ink-3);
  }

  /* You are here: the same 2px accent underline as the header's top-level items. */
  .nav-row[aria-current='page'] .nav-row__label::after {
    content: '';
    position: absolute;
    inset: auto 0 -3px;
    height: 2px;
    border-radius: var(--radius-xs);
    background: var(--accent);
  }

  @media (forced-colors: active) {
    .nav-row[aria-current='page'] .nav-row__label::after {
      forced-color-adjust: none;
      background: Highlight;
    }
  }
</style>
