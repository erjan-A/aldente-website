---
import wordmark from '../../assets/logos/aldente-wordmark.svg';
import { LINKS, NAV_GROUPS, isNavMenu, type NavLink } from '../../data/site';
import { activeEntry, isCurrentPage, pagePath } from '../../lib/paths';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import NavRow from './NavRow.astro';

const pathname = Astro.url.pathname;
const isCurrent = (href: string) => isCurrentPage(pathname, href);
/** The top-level entry that holds this page ("Product" on /order-verification), marked with the accent underline. */
const active = activeEntry(
  pathname,
  NAV_GROUPS.map((group) => (isNavMenu(group) ? group.items.map((item) => item.href) : [group.href])),
);
const menus = NAV_GROUPS.filter(isNavMenu);
const links = NAV_GROUPS.filter((group): group is NavLink => !isNavMenu(group));
const slug = (label: string) => label.toLowerCase().replace(/[^a-z0-9]+/g, '-');
/** On the booking page both header buttons jump to the calendar instead of reloading the page. */
const bookHref = pagePath(pathname) === LINKS.demo ? '#schedule' : LINKS.demo;
---

<header class="header">
  <div class="container header__bar">
    <a href="/" class="header__logo" aria-label="Aldente AI home">
      <img src={wordmark.src} width={124} height={26} alt="" />
    </a>

    <nav-menu class="header__nav">
      <nav aria-label="Main">
        <ul role="list" class="nav">
          {
            NAV_GROUPS.map((group, index) =>
              isNavMenu(group) ? (
                <li class="nav__group">
                  <button
                    type="button"
                    class:list={['nav__top', { 'is-active': index === active }]}
                    aria-expanded="false"
                    aria-controls={`nav-${slug(group.label)}`}
                  >
                    <span class="nav__label">{group.label}</span>
                    <Icon name="chevron-down" size={16} strokeWidth={2} class="nav__chevron" />
                  </button>
                  <div id={`nav-${slug(group.label)}`} class="nav__panel">
                    <ul role="list" class="nav__card">
                      {group.items.map((item) => (
                        <li>
                          <NavRow item={item} current={isCurrent(item.href)} />
                        </li>
                      ))}
                    </ul>
                  </div>
                </li>
              ) : (
                <li>
                  <a
                    href={group.href}
                    class:list={['nav__top', { 'is-active': index === active }]}
                    aria-current={isCurrent(group.href) ? 'page' : undefined}
                  >
                    <span class="nav__label">{group.label}</span>
                  </a>
                </li>
              ),
            )
          }
        </ul>
      </nav>
    </nav-menu>

    <div class="header__actions">
      <Button href={bookHref} size="sm" class="header__cta">Book a demo</Button>
      <site-nav class="header__mobile">
        <button type="button" class="header__toggle" aria-expanded="false" aria-controls="mobile-menu">
          <Icon name="menu" size={22} class="header__icon-open" />
          <Icon name="x" size={22} class="header__icon-close" />
          <span class="visually-hidden">Menu</span>
        </button>

        <div id="mobile-menu" class="mmenu" hidden>
          <div class="mmenu__panel" data-menu-panel>
            <nav class="container mmenu__nav" aria-label="Mobile">
              <div class="mmenu__groups">
                {
                  menus.map((menu) => (
                    <div class="mmenu__group">
                      <p class="mmenu__title" id={`mmenu-${slug(menu.label)}`}>
                        {menu.label}
                      </p>
                      <ul role="list" aria-labelledby={`mmenu-${slug(menu.label)}`}>
                        {menu.items.map((item) => (
                          <li>
                            <NavRow item={item} current={isCurrent(item.href)} />
                          </li>
                        ))}
                      </ul>
                    </div>
                  ))
                }
              </div>
              <ul role="list" class="mmenu__links">
                {
                  links.map((link) => (
                    <li>
                      <a href={link.href} class="mmenu__link" aria-current={isCurrent(link.href) ? 'page' : undefined}>
                        <span class="nav__label">{link.label}</span>
                      </a>
                    </li>
                  ))
                }
              </ul>
              <Button href={bookHref} size="lg" arrow class="mmenu__cta">Book a demo</Button>
            </nav>
          </div>
        </div>
      </site-nav>
    </div>
  </div>
</header>

<script>
  import '../../scripts/nav-menu';
  import '../../scripts/site-nav';
</script>

<style>
  /* Height: --header-h in global.css, which sticky elements and anchor offsets also read. */
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
  }

  /* The glass sits on a pseudo-element: backdrop-filter on .header itself would trap the fixed mobile menu inside it. */
  .header::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgb(11 11 11 / 0.92);
    border-bottom: 1px solid var(--line);
    -webkit-backdrop-filter: saturate(140%) blur(10px);
    backdrop-filter: saturate(140%) blur(10px);
  }

  .header__bar {
    height: var(--header-h);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 24px;
  }

  /* A full 44px tap target around the 26px wordmark. */
  .header__logo {
    flex: none;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
  }

  .header__nav {
    display: block;
  }

  .header__logo img {
    height: 26px;
    width: auto;
  }

  /* Desktop navigation: Product ▾ · Solutions ▾ · Security · Pricing · Company. */
  .nav {
    display: flex;
    align-items: center;
    gap: 4px;
  }

  .nav__group {
    position: relative;
  }

  .nav__top {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    min-height: 44px;
    padding: 0 12px;
    border: 0;
    border-radius: var(--radius-pill);
    background: none;
    color: var(--ink-2);
    font-size: var(--step-small);
    font-weight: 500;
    line-height: 1;
    cursor: pointer;
    transition: color 0.15s ease;
  }

  .nav__top:hover,
  .nav__top[aria-expanded='true'],
  .nav__top.is-active {
    color: var(--ink);
  }

  .nav__label {
    position: relative;
  }

  /* You are here: a 2px accent underline under the current item, or under the menu that holds the page. */
  .nav__top.is-active .nav__label::after,
  .mmenu__link[aria-current='page'] .nav__label::after {
    content: '';
    position: absolute;
    inset: auto 0 -8px;
    height: 2px;
    border-radius: var(--radius-xs);
    background: var(--accent);
  }

  .nav__top :global(.nav__chevron) {
    flex: none;
    margin-right: -2px;
    color: var(--ink-3);
    transition: transform 0.2s var(--ease-out);
  }

  .nav__top[aria-expanded='true'] :global(.nav__chevron) {
    transform: rotate(180deg);
  }

  /* The panel is shown while its button is expanded, so opening it never moves the bar. The transparent top
     padding bridges the gap under the button, so the pointer can travel into the panel without closing it. */
  .nav__panel {
    display: none;
    position: absolute;
    top: 100%;
    left: -8px;
    padding-top: 20px;
  }

  .nav__top[aria-expanded='true'] + .nav__panel {
    display: block;
  }

  /* Before the script runs, hover and keyboard focus still open the menus. */
  nav-menu:not(:defined) .nav__group:is(:hover, :focus-within) > .nav__panel {
    display: block;
  }

  .nav__card {
    display: grid;
    gap: 2px;
    width: 368px;
    padding: 8px;
    border-radius: var(--radius-m);
    border: 1px solid var(--line-card);
    background: var(--surface);
    box-shadow:
      0 24px 48px -16px rgb(0 0 0 / 0.7),
      0 4px 12px -4px rgb(0 0 0 / 0.45);
  }

  .header__actions {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .header__toggle {
    display: none;
    width: 44px;
    height: 44px;
    align-items: center;
    justify-content: center;
    border-radius: var(--radius-s);
    border: 1px solid var(--line-card);
    background: transparent;
    cursor: pointer;
    transition: border-color 0.15s ease;
  }

  .header__toggle:hover,
  .header__toggle[aria-expanded='true'] {
    border-color: var(--line-strong);
  }

  .header__toggle :global(.header__icon-close),
  .header__toggle[aria-expanded='true'] :global(.header__icon-open) {
    display: none;
  }

  .header__toggle[aria-expanded='true'] :global(.header__icon-close) {
    display: block;
  }

  /* Mobile menu: a fixed sheet under the bar over a dimmed backdrop; a tap on the backdrop closes it.
     The sheet scrolls on its own when it is taller than the screen. */
  .mmenu {
    position: fixed;
    inset: var(--header-h) 0 0;
    display: flex;
    flex-direction: column;
    background: rgb(0 0 0 / 0.64);
  }

  .mmenu__panel {
    flex: 1 1 auto;
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .mmenu__nav {
    display: flex;
    flex-direction: column;
    padding-block: 8px 24px;
  }

  .mmenu__groups {
    display: grid;
    gap: 8px;
  }

  .mmenu__title {
    padding: 12px 0 4px;
    font-size: var(--step-label);
    font-weight: 500;
    color: var(--ink-3);
  }

  .mmenu__group :global(.nav-row) {
    min-height: 56px;
    margin-inline: -12px;
    padding-block: 8px;
  }

  .mmenu__links {
    margin-top: 16px;
    border-top: 1px solid var(--line);
  }

  .mmenu__link {
    display: flex;
    align-items: center;
    min-height: 52px;
    border-bottom: 1px solid var(--line);
    font-size: var(--step-body);
    font-weight: 500;
    color: var(--ink);
  }

  .mmenu__link[aria-current='page'] .nav__label::after {
    bottom: -6px;
  }

  .mmenu__nav :global(.mmenu__cta) {
    width: 100%;
    margin-top: 24px;
  }

  @media (forced-colors: active) {
    .nav__top.is-active .nav__label::after,
    .mmenu__link[aria-current='page'] .nav__label::after {
      forced-color-adjust: none;
      background: Highlight;
    }
  }

  @keyframes header-menu-in {
    from {
      opacity: 0;
      transform: translateY(-6px);
    }
  }

  @keyframes header-backdrop-in {
    from {
      opacity: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .nav__top[aria-expanded='true'] + .nav__panel .nav__card {
      animation: header-menu-in 0.18s var(--ease-out);
    }

    .mmenu:not([hidden]) {
      animation: header-backdrop-in 0.2s ease-out;
    }

    .mmenu:not([hidden]) .mmenu__panel {
      animation: header-menu-in 0.24s var(--ease-out);
    }
  }

  @media (min-width: 640px) {
    .mmenu__groups {
      grid-template-columns: 1fr 1fr;
      gap: 32px;
    }
  }

  @media (max-width: 960px) {
    .header__nav {
      display: none;
    }

    .header__toggle {
      display: inline-flex;
    }

    /* While the menu is open the page behind it stays put, and the bar turns solid to join the sheet. */
    :global(html[data-menu-open]) {
      overflow: hidden;
    }

    :global(html[data-menu-open]) .header {
      z-index: 70;
    }

    :global(html[data-menu-open]) .header::before {
      background: var(--bg);
    }

    /* The sheet has its own full-width "Book a demo"; one orange booking button on screen at a time. */
    :global(html[data-menu-open]) .header__actions :global(.header__cta) {
      visibility: hidden;
    }
  }

  /* Short phones (360x740 and smaller): tighter rows, so the sheet's "Book a demo" fits without scrolling. */
  @media (max-width: 960px) and (max-height: 760px) {
    .mmenu__group :global(.nav-row) {
      min-height: 48px;
      padding-block: 4px;
    }

    .mmenu__title {
      padding-top: 8px;
    }

    .mmenu__link {
      min-height: 48px;
    }

    .mmenu__links {
      margin-top: 8px;
    }

    .mmenu__nav :global(.mmenu__cta) {
      margin-top: 16px;
    }
  }

  @media (max-width: 340px) {
    .header__actions :global(.header__cta) {
      display: none;
    }
  }

  @media (min-width: 961px) {
    .mmenu {
      display: none !important;
    }
  }
</style>
