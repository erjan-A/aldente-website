---
import { LINKS } from '../../data/site';

// Optional categories start unticked; necessary storage only remembers this choice. Visit counting
// (Umami) is cookieless and stores nothing in the browser, so it is not offered as a choice.
const categories = [
  { name: 'marketing', label: 'Marketing', text: 'Lets Calendly’s booking calendar on the demo page set its cookies without asking you again.' },
];
---

<!--
  One compact panel: a line of text and one row of choices. Phones: a full-width strip at the
  bottom (under 120px, safe-area aware). From 640px: a small card at the bottom left.
  "Settings" opens the per-category choices inside the same panel.
-->
<cookie-consent class="consent" hidden>
  <section class="consent__card" aria-labelledby="consent-title">
    <h2 id="consent-title" class="visually-hidden">Cookies</h2>
    <p class="consent__text">
      We set no cookies. Calendly does, only if you allow it.{' '}
      <a href={LINKS.cookies}>Cookie policy</a>
    </p>
    <div class="consent__settings" data-consent-settings hidden>
      <label class="consent__option">
        <input type="checkbox" checked disabled />
        <span><b>Necessary</b><small>Remembers this choice. Always on.</small></span>
      </label>
      {
        categories.map((c) => (
          <label class="consent__option">
            <input type="checkbox" name={c.name} />
            <span>
              <b>{c.label}</b>
              <small>{c.text}</small>
            </span>
          </label>
        ))
      }
    </div>
    <div class="consent__actions">
      <button type="button" class="consent__btn" data-consent="reject">Reject all</button>
      <button type="button" class="consent__btn" data-consent="accept">Accept all</button>
      <button type="button" class="consent__btn consent__btn--save" data-consent="save" hidden>Save choices</button>
      <button type="button" class="consent__more" data-consent="settings" aria-expanded="false">Settings</button>
    </div>
  </section>
</cookie-consent>

<script>
  import '../../scripts/cookie-consent';
</script>

<style>
  /* Phones: a full-width strip on the bottom edge. */
  .consent {
    position: fixed;
    z-index: 60;
    left: 0;
    right: 0;
    bottom: 0;
    display: block;
  }

  .consent__card {
    display: flex;
    flex-direction: column;
    gap: 10px;
    max-height: calc(100dvh - var(--header-h) - 16px);
    overflow-y: auto;
    padding: 12px 16px calc(12px + env(safe-area-inset-bottom, 0px));
    padding-left: max(16px, env(safe-area-inset-left, 0px));
    padding-right: max(16px, env(safe-area-inset-right, 0px));
    border-radius: var(--radius-m) var(--radius-m) 0 0;
    background: var(--surface);
    border-top: 1px solid var(--line-card);
    box-shadow: 0 -16px 40px rgb(0 0 0 / 0.45);
    color: var(--ink);
  }

  /* One line on a 360px phone at the label step; the roomier card from 640px takes the small step. */
  .consent__text {
    font-size: var(--step-label);
    line-height: 1.4;
    color: var(--ink-2);
  }

  .consent__text a {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    white-space: nowrap;
  }

  .consent__settings {
    display: flex;
    flex-direction: column;
    border-top: 1px solid var(--line);
  }

  .consent__option {
    display: flex;
    align-items: flex-start;
    gap: 12px;
    padding: 10px 0;
    border-bottom: 1px solid var(--line);
    cursor: pointer;
  }

  .consent__option input {
    flex: none;
    width: 18px;
    height: 18px;
    margin-top: 2px;
  }

  .consent__option span {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .consent__option b {
    font-size: var(--step-small);
    font-weight: 600;
  }

  .consent__option small {
    font-size: var(--step-label);
    color: var(--ink-3);
  }

  .consent__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  /* Accept and reject carry the same weight. */
  .consent__btn {
    flex: 1 1 0;
    min-width: 0;
    min-height: 44px;
    padding: 0 14px;
    border-radius: var(--radius-pill);
    border: 1px solid var(--line-strong);
    background: transparent;
    color: var(--ink);
    font-size: var(--step-small);
    font-weight: 600;
    white-space: nowrap;
    cursor: pointer;
    transition: border-color 0.2s ease;
  }

  .consent__btn:hover {
    border-color: var(--ink);
  }

  .consent__btn--save {
    flex-basis: 100%;
    order: 1;
    border-color: var(--ink);
    background: var(--ink);
    color: var(--bg);
  }

  /* Settings: a text button on the same row, still 44px tall. */
  .consent__more {
    flex: none;
    min-height: 44px;
    padding: 0 6px;
    border: 0;
    border-radius: var(--radius-s);
    background: none;
    color: var(--ink-2);
    font-size: var(--step-small);
    font-weight: 500;
    text-decoration: underline;
    text-underline-offset: 3px;
    cursor: pointer;
  }

  .consent__more:hover {
    color: var(--ink);
  }

  .consent__more[aria-expanded='true'] {
    display: none;
  }

  /* From 640px: a small card at the bottom left. */
  @media (min-width: 640px) {
    .consent {
      left: 24px;
      right: auto;
      bottom: 24px;
      width: min(420px, calc(100vw - 48px));
    }

    .consent__text {
      font-size: var(--step-small);
    }

    .consent__card {
      gap: 12px;
      max-height: calc(100dvh - 120px);
      padding: 16px;
      border-radius: var(--radius-l);
      border: 1px solid var(--line-card);
      box-shadow: 0 24px 64px rgb(0 0 0 / 0.5);
    }
  }

  /* Phones in landscape: a wider, lower card so the line fits on one row and the card stays under 100px. */
  @media (min-width: 640px) and (max-height: 500px) {
    .consent {
      bottom: 12px;
      width: min(560px, calc(100vw - 48px));
    }

    .consent__text {
      font-size: var(--step-label);
    }

    .consent__card {
      gap: 10px;
      padding: 12px 16px;
    }
  }
</style>
