---
import { SITE } from '../../data/site';
import Icon from '../ui/Icon.astro';

/**
 * Calendly's scheduler with its own states: a quiet month skeleton while it loads, the calendar, then
 * "You're booked" (src/scripts/calendly-embed.ts). It stands in two places: on the booking page, where it
 * loads with the page, and in the sticky button's panel (BookDemo), where it waits to be opened (`lazy`).
 * The surface around it is the caller's: a Card with pad="none", named by the heading's id (`titleId`).
 */
interface Props {
  /** The id of the "Pick a time" heading, which names the surface that holds the calendar. */
  titleId: string;
  /** Ask Calendly for nothing until the calendar is opened (the panel). */
  lazy?: boolean;
  /** A narrow panel no taller than the screen: the head stays, the calendar scrolls under it. */
  panel?: boolean;
}

const { titleId, lazy = false, panel = false } = Astro.props;

// The calendar skeleton: a month of day cells, a quiet hint of the scheduler until it loads.
const days = Array.from({ length: 35 }, (_, i) => i);
const weekdays = Array.from({ length: 7 }, (_, i) => i);
---

<calendly-embed class:list={['cal', { 'cal--panel': panel }]} data-url={SITE.calendly} data-lazy={lazy || undefined}>
  <div class="cal__head">
    <h2 id={titleId} class="cal__title">Pick a time</h2>
    <p class="cal__meta">A 30-minute demo with our team</p>
    <slot name="action" />
  </div>

  <div class="cal__stage" data-cal-stage data-artifact-calendar>
    <div class="cal__skeleton" data-cal-skeleton aria-hidden="true">
      <div class="sk__title"></div>
      <div class="sk__month"><div></div><div></div><div></div></div>
      <div class="sk__grid">
        {weekdays.map(() => <div class="sk__weekday" />)}
        {days.map(() => <div class="sk__day" />)}
      </div>
      <div class="sk__zone"><div></div><div></div></div>
    </div>
    <noscript>
      <p class="cal__noscript"><a href={SITE.calendly} target="_blank" rel="noopener">Pick a time on Calendly</a></p>
    </noscript>
    <div class="cal__overlay">
      <p class="cal__status" role="status" aria-live="polite" data-cal-status></p>
      <p class="cal__slow" data-cal-slow hidden>
        Taking longer than usual? <a href={SITE.calendly} target="_blank" rel="noopener">Open the scheduler on Calendly</a>.
      </p>
    </div>
  </div>

  <div class="cal__booked" data-cal-booked hidden>
    <span class="cal__booked-mark"><Icon name="check" size={22} /></span>
    <h3 class="cal__booked-title" tabindex="-1">You’re booked.</h3>
    <ul class="cal__next" role="list">
      <li>Calendly emails you the invite.</li>
      <li>Before the call, our team looks at your locations and the questions you shared.</li>
      <li>Questions before then? Write to <a href={`mailto:${SITE.email}`}>{SITE.email}</a> or call <a href={SITE.phoneHref} class="nowrap">{SITE.phone}</a>.</li>
    </ul>
  </div>
</calendly-embed>

<script>
  import '../../scripts/calendly-embed';
</script>

<style>
  .cal {
    display: flex;
    flex-direction: column;
  }

  .cal__head {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 4px 16px;
    padding: var(--card-pad-m) var(--card-pad-m) 16px;
  }

  .cal__title {
    font-size: var(--step-h3);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .cal__meta {
    font-size: var(--step-small);
    color: var(--fg-2);
  }

  .cal__slow a,
  .cal__next a {
    color: var(--fg);
    text-decoration: underline;
    text-decoration-color: var(--line-strong);
    text-underline-offset: 3px;
    transition: text-decoration-color 0.2s ease;
  }

  .cal__slow a:hover,
  .cal__next a:hover {
    text-decoration-color: currentColor;
  }

  /* The stage holds the skeleton, then Calendly's iframe, which runs edge to edge in the card. */
  .cal__stage {
    position: relative;
    min-height: 440px;
    border-top: 1px solid var(--line);
  }

  .cal__skeleton {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
    padding: 32px 16px;
  }

  .sk__title {
    width: 112px;
    height: 12px;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
  }

  .sk__month {
    display: flex;
    align-items: center;
    justify-content: space-between;
    width: min(100%, 220px);
  }

  .sk__month > div {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background: var(--surface-2);
  }

  .sk__month > div:nth-child(2) {
    width: 104px;
    height: 10px;
    border-radius: var(--radius-xs);
  }

  .sk__grid {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 40px));
    justify-content: center;
    gap: 8px 8px;
    width: 100%;
  }

  .sk__zone {
    display: flex;
    flex-direction: column;
    gap: 12px;
    width: min(100%, 304px);
  }

  .sk__zone > div {
    width: 72px;
    height: 8px;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
  }

  .sk__zone > div + div {
    width: 160px;
    opacity: 0.6;
  }

  .sk__weekday {
    justify-self: center;
    width: 22px;
    height: 6px;
    margin-bottom: 8px;
    border-radius: var(--radius-xs);
    background: var(--surface-2);
  }

  .sk__day {
    aspect-ratio: 1;
    border-radius: 50%;
    border: 1px solid var(--line);
  }

  /* Weekends sit quieter, as in the scheduler. */
  .sk__day:nth-child(7n + 6),
  .sk__day:nth-child(7n + 7) {
    border-color: transparent;
    background: radial-gradient(circle, var(--line) 0 2px, transparent 2.5px);
  }

  .cal__overlay {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 12px;
    padding: 24px;
    text-align: center;
    /* A soft pool of the card colour behind the status line, so the month grid stays visible around it. */
    background: radial-gradient(ellipse 50% 28% at 50% 50%, var(--card) 45%, color-mix(in srgb, var(--card) 0%, transparent));
  }

  .cal__status {
    display: inline-flex;
    align-items: center;
    gap: 12px;
    font-size: var(--step-small);
    font-weight: 500;
    color: var(--fg-2);
  }

  .cal__status::before {
    content: '';
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
  }

  /* Empty until loading starts, but kept in the accessibility tree so the change is announced. */
  .cal__status:empty {
    position: absolute;
  }

  .cal__status:empty::before {
    content: none;
  }

  .cal__slow {
    max-width: 32ch;
    font-size: var(--step-label);
    line-height: 1.5;
    color: var(--fg-3);
  }

  /* Calendly's iframe (added by <calendly-embed>): hidden behind the skeleton until Calendly answers. */
  .cal__stage :global(.cal__frame) {
    display: block;
    width: 100%;
    height: 640px;
    border: 0;
    background: transparent;
    /* Calendly's page is light-scheme: matching it keeps the frame transparent below Calendly's content
       instead of the white backdrop browsers paint when the schemes differ. */
    color-scheme: light;
  }

  .cal[data-state='loading'] :global(.cal__frame) {
    position: absolute;
    inset: 0;
    height: 100%;
    opacity: 0;
    pointer-events: none;
  }

  .cal[data-state='ready'] .cal__overlay {
    display: none;
  }

  /* After a booking: what happens next. */
  .cal__booked {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 16px;
    min-height: 360px;
    padding: 32px var(--card-pad-m) 40px;
    border-top: 1px solid var(--line);
  }

  .cal__booked-mark {
    display: grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: 50%;
    background: var(--ok-soft);
    color: var(--ok);
  }

  .cal__booked-title {
    font-size: var(--step-h3);
    line-height: 1.2;
    letter-spacing: -0.02em;
  }

  .cal__booked-title:focus {
    outline: none;
  }

  .cal__next {
    display: flex;
    flex-direction: column;
    max-width: 46ch;
    color: var(--fg-2);
  }

  .cal__next li {
    padding-block: 12px;
    border-top: 1px solid var(--line);
  }

  /* ---------- In a panel (the sticky button's dialog): the head stays, the calendar scrolls. ---------- */

  .cal--panel {
    min-height: 0;
  }

  /* The title with the panel's Close beside it, then the line under both: it keeps one row on a phone. */
  .cal--panel .cal__head {
    flex: none;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    align-items: center;
    gap: 4px 16px;
    padding: 12px 12px 16px 20px;
  }

  .cal--panel .cal__meta {
    grid-column: 1 / -1;
    grid-row: 2;
  }

  .cal--panel .cal__stage,
  .cal--panel .cal__booked {
    flex: 0 1 auto;
    min-height: 0;
    overflow-y: auto;
    overscroll-behavior: contain;
  }

  .cal--panel .cal__booked {
    padding: 24px 20px 28px;
  }

  @media (min-width: 1024px) {
    .cal__stage {
      min-height: 600px;
    }

    .cal__skeleton {
      gap: 28px;
      padding-top: 48px;
    }

    .sk__grid {
      grid-template-columns: repeat(7, minmax(0, 44px));
      gap: 12px 8px;
    }

    .sk__zone {
      width: min(100%, 356px);
    }

    .cal--panel .cal__stage {
      min-height: 0;
    }
  }

  @media (prefers-reduced-motion: no-preference) {
    .cal[data-state='loading'] .sk__day {
      animation: sk-breathe 1.4s ease-in-out infinite alternate;
    }

    .cal[data-state='loading'] .cal__status::before {
      animation: sk-breathe 0.8s ease-in-out infinite alternate;
    }

    .cal[data-state='ready'] :global(.cal__frame) {
      animation: cal-in 0.4s var(--ease-out);
    }
  }

  @keyframes sk-breathe {
    from {
      opacity: 1;
    }
    to {
      opacity: 0.4;
    }
  }

  @keyframes cal-in {
    from {
      opacity: 0;
    }
  }
</style>
