---
import { Image } from 'astro:assets';
import '../../styles/slack.css';
import dining from '../../assets/images/dining-room-overhead.jpg';
import tray from '../../assets/images/order-tray.jpg';
import mark from '../../assets/logos/aldente-mark.svg';
import Icon from '../ui/Icon.astro';
import ProductPill from '../ui/ProductPill.astro';
import HeroDeck from './HeroDeck.astro';

/**
 * The hero's cards, "What Aldente sees": four 16:9 frames, each under its product's pill with what
 * happened next. Two are camera frames with one detection (boxes in % of the frame, photos cropped centre);
 * the dispute and Aldo's HR case show the product UI instead. The first frame loads with the page.
 */
const photos = {
  check: {
    image: tray,
    box: { left: 66, top: 33, width: 32, height: 62 },
    label: '1 of 2 drinks',
  },
  table: {
    image: dining,
    box: { left: 26, top: 64, width: 34, height: 28 },
    label: 'Table 6 · to clear · 3:12',
  },
};
---

<HeroDeck>
  <div class="hd__card see">
    <div class="see__frame">
      <Image src={photos.check.image} alt="" widths={[320, 560]} sizes="280px" loading="eager" />
      <span class="see__box" style={`left:${photos.check.box.left}%;top:${photos.check.box.top}%;width:${photos.check.box.width}%;height:${photos.check.box.height}%`}>
        <span class="see__label">{photos.check.label}</span>
      </span>
      <span class="see__pill"><ProductPill product="verify" /></span>
    </div>
    <p class="see__text"><span class="see__ok"><Icon name="check" size={11} strokeWidth={3} /></span>Caught before pickup</p>
  </div>

  <div class="hd__card see">
    <div class="see__frame see__frame--ui dsp">
      <span class="see__pill"><ProductPill product="verify" /></span>
      <span class="dsp__status"><Icon name="check" size={10} strokeWidth={3} />Reversed</span>
      <div class="dsp__body">
        <p class="dsp__order"><b>Order #4821</b> · Uber Eats</p>
        <p class="dsp__claim">Claim: missing drink · <b>$17.40</b></p>
        <p class="dsp__msg"><b>Aldente</b> All 4 items were packed. Clip attached.</p>
        <p class="dsp__back"><Icon name="check" size={11} strokeWidth={3} />$17.40 back to Location 01</p>
      </div>
    </div>
    <p class="see__text"><span class="see__ok"><Icon name="check" size={11} strokeWidth={3} /></span>Won back with the clip</p>
  </div>

  <div class="hd__card see">
    <div class="see__frame">
      <Image src={photos.table.image} alt="" widths={[320, 560]} sizes="280px" loading="lazy" />
      <span class="see__box" style={`left:${photos.table.box.left}%;top:${photos.table.box.top}%;width:${photos.table.box.width}%;height:${photos.table.box.height}%`}>
        <span class="see__label">{photos.table.label}</span>
      </span>
      <span class="see__pill"><ProductPill product="vision" /></span>
    </div>
    <p class="see__text"><span class="see__ok"><Icon name="check" size={11} strokeWidth={3} /></span>Floor team alerted in Slack</p>
  </div>

  <div class="hd__card see">
    <div class="see__frame see__frame--ui hr slack">
      <span class="see__pill"><ProductPill product="aldo" /></span>
      <span class="hr__channel">#hr-review</span>
      <div class="hr__msg">
        <span class="hr__av"><img src={mark.src} alt="" width="10" height="12" /></span>
        <div class="hr__body">
          <p class="hr__title"><b>1 missing clock-out needs review</b></p>
          <p class="hr__fields">EMP-07 · left 21:14 · clock-out <em>missing</em></p>
          <span class="hr__btn">Review case</span>
        </div>
      </div>
    </div>
    <p class="see__text"><span class="see__ok"><Icon name="check" size={11} strokeWidth={3} /></span>HR case prepared by Aldo</p>
  </div>
</HeroDeck>

<style>
  .see {
    gap: 0;
    padding: 0;
    overflow: hidden;
    border-radius: 18px;
  }

  .see__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    flex: none;
    background: #000000;
  }

  .see__frame > :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .see__pill {
    position: absolute;
    left: 10px;
    top: 10px;
    display: flex;
  }

  /* The design system's detection: a 3px box with a 10px radius, the label in a solid chip above it. */
  .see__box {
    position: absolute;
    border: 3px solid var(--accent);
    border-radius: 10px;
  }

  .see__label {
    position: absolute;
    left: -3px;
    bottom: calc(100% + 4px);
    padding: 2px 7px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  .see__label {
    background: var(--accent);
    color: var(--on-accent);
  }

  /* The two UI frames: light panels, with the content under the pill. */
  .see__frame--ui {
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    padding: 46px 12px 10px;
  }

  /* The dispute: the decks' light dispute desk (#fafaf8, #141414 ink, green for resolved, darkened for AA). */
  .dsp {
    background: #fafaf8;
    color: #141414;
  }

  .dsp__status {
    position: absolute;
    top: 14px;
    right: 12px;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 2px 8px;
    border-radius: 999px;
    background: #e6f5ec;
    color: #147a43;
    font-size: 11px;
    font-weight: 700;
  }

  .dsp__body {
    display: flex;
    flex-direction: column;
    gap: 3px;
    font-size: 11.5px;
    line-height: 1.3;
  }

  .dsp__claim {
    color: #6b6b6b;
  }

  .dsp__claim b {
    color: #141414;
  }

  .dsp__msg {
    align-self: flex-end;
    max-width: 92%;
    margin-top: 2px;
    padding: 4px 8px;
    border-radius: 10px 10px 3px 10px;
    background: var(--accent);
    color: var(--on-accent);
  }

  .dsp__msg b {
    margin-right: 4px;
  }

  .dsp__back {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    margin-top: 2px;
    color: #147a43;
    font-weight: 700;
  }

  /* Aldo's HR case in Slack: the minimal window's message, with the next action. */
  .hr {
    justify-content: center;
    background: #ffffff;
    color: var(--slack-text);
  }

  .hr__channel {
    position: absolute;
    top: 16px;
    right: 12px;
    color: var(--slack-muted);
    font-size: 11.5px;
    font-weight: 700;
  }

  .hr__msg {
    display: flex;
    gap: 8px;
    align-items: flex-start;
  }

  .hr__av {
    flex: none;
    display: grid;
    place-items: center;
    width: 24px;
    height: 24px;
    border-radius: 5px;
    background: #0b0b0b;
  }

  .hr__av img {
    width: 10px;
    height: auto;
  }

  .hr__body {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 3px;
    min-width: 0;
    font-size: 12px;
    line-height: 1.3;
  }

  .hr__fields {
    color: var(--slack-muted);
  }

  .hr__fields em {
    font-style: normal;
    font-weight: 700;
    color: #b8401f;
  }

  .hr__btn {
    margin-top: 2px;
    padding: 3px 10px;
    border-radius: 4px;
    background: var(--slack-green);
    color: #ffffff;
    font-size: 11.5px;
    font-weight: 700;
  }

  /* One short outcome line under the frame. */
  .see__text {
    flex: 1;
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 12px 10px;
    font-size: 12.5px;
    font-weight: 600;
    line-height: 1.3;
    color: var(--ink);
  }

  .see__ok {
    flex: none;
    display: grid;
    place-items: center;
    width: 18px;
    height: 18px;
    border-radius: 50%;
    background: var(--ok-soft);
    color: var(--ok);
  }
</style>
