---
import { Image } from 'astro:assets';
import dining from '../../assets/images/dining-room-overhead.jpg';
import trayComplete from '../../assets/images/order-tray-complete.jpg';
import tray from '../../assets/images/order-tray.jpg';
import departure from '../../assets/images/staff-departure.jpg';
import ProductPill from '../ui/ProductPill.astro';
import HeroDeck from './HeroDeck.astro';

/**
 * The hero's cards, "What Aldente sees": four camera frames, each with the one thing Aldente spotted and
 * what happened next, under the product's pill. Every frame is 16:9; boxes are in % of the frame (photos
 * cropped centre). The first frame loads with the page; the rest wait their turn.
 */
const cards = [
  {
    product: 'verify' as const,
    image: tray,
    box: { left: 66, top: 33, width: 32, height: 62 },
    label: '1 of 2 drinks',
    tone: 'alert',
    title: 'Wrong order caught at packing.',
    detail: 'The drink goes in before pickup.',
  },
  {
    product: 'verify' as const,
    image: trayComplete,
    box: { left: 3, top: 4, width: 94, height: 90 },
    label: 'All 4 items in the bag',
    tone: 'ok',
    inside: true,
    title: 'Refund disputed with the clip.',
    detail: 'Uber Eats returns the $17.40.',
  },
  {
    product: 'vision' as const,
    image: dining,
    box: { left: 26, top: 64, width: 34, height: 28 },
    label: 'Table 6 · to clear · 3:12',
    tone: 'alert',
    title: 'Table 6 waiting 3 minutes.',
    detail: 'The floor team hears in Slack.',
  },
  {
    product: 'aldo' as const,
    image: departure,
    box: { left: 63, top: 13, width: 19, height: 50 },
    label: 'Left 21:14 · no clock-out',
    tone: 'alert',
    labelEnd: true,
    labelBelow: true,
    title: 'Missed clock-out found.',
    detail: 'Aldo prepares the HR case.',
  },
];
---

<HeroDeck>
  {
    cards.map((c, i) => (
      <div class="hd__card see">
        <div class="see__frame">
          <Image src={c.image} alt="" widths={[320, 560]} sizes="280px" loading={i === 0 ? 'eager' : 'lazy'} />
          <span
            class:list={['see__box', `see__box--${c.tone}`, { 'see__box--inside': c.inside, 'see__box--end': c.labelEnd, 'see__box--below': c.labelBelow }]}
            style={`left:${c.box.left}%;top:${c.box.top}%;width:${c.box.width}%;height:${c.box.height}%`}
          >
            <span class="see__label">{c.label}</span>
          </span>
          <span class="see__pill">
            <ProductPill product={c.product} />
          </span>
        </div>
        <p class="see__text">
          <b>{c.title}</b> <span>{c.detail}</span>
        </p>
      </div>
    ))
  }
</HeroDeck>

<style>
  .see {
    gap: 0;
    padding: 0;
    overflow: hidden;
  }

  .see__frame {
    position: relative;
    aspect-ratio: 16 / 9;
    flex: none;
    background: #000000;
  }

  .see__frame :global(img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .see__pill {
    position: absolute;
    left: 10px;
    top: 10px;
    display: flex;
  }

  /* The design system's detection: a 3px box with a 10px radius, the label in a solid chip above it. */
  .see__box {
    position: absolute;
    border: 3px solid;
    border-radius: 10px;
  }

  .see__box--alert {
    border-color: var(--accent);
  }

  .see__box--ok {
    border-color: var(--ok);
  }

  .see__label {
    position: absolute;
    left: -3px;
    bottom: calc(100% + 4px);
    padding: 2px 7px;
    border-radius: 6px;
    font-size: 11px;
    font-weight: 600;
    line-height: 1.4;
    white-space: nowrap;
  }

  .see__box--end .see__label {
    left: auto;
    right: -3px;
  }

  /* Near the top edge the label goes under the box, as the design system says. */
  .see__box--below .see__label {
    top: calc(100% + 4px);
    bottom: auto;
  }

  .see__box--inside .see__label {
    left: 6px;
    top: auto;
    bottom: 6px;
  }

  .see__box--alert .see__label {
    background: var(--accent);
    color: #0b0b0b;
  }

  .see__box--ok .see__label {
    background: var(--ok);
    color: #0b0b0b;
  }

  .see__text {
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 2px;
    padding: 10px 14px 12px;
    font-size: 13px;
    line-height: 1.35;
  }

  .see__text b {
    font-weight: 600;
    color: var(--ink);
  }

  .see__text span {
    color: var(--ink-2);
  }

  /* Small phones: the headline only, so the frame keeps its 16:9. */
  @media (max-width: 479px) {
    .see__text span {
      display: none;
    }
  }
</style>
