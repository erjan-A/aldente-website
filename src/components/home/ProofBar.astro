---
import { Image } from 'astro:assets';
import { CUSTOMER_LOGOS } from '../../data/logos';
import { retina } from '../../lib/images';
import { COUNTER } from '../../data/site';
import { valueAt } from '../../lib/counter';
import { formatNumber } from '../../lib/format';

// A static figure until a stats endpoint exists; then a live counter, rendered at build time and kept current in the browser.
const live = Boolean(COUNTER.endpoint);
const initial = formatNumber(valueAt({ ...COUNTER, baseTime: Date.parse(COUNTER.baseTime) }, Date.now()));

// The row loops by sliding exactly half its length, so it holds two identical sets. Only the first is announced.
const sets = [0, 1];
const line = 'orders served across 200+ restaurant locations.';

---

<div class="proof" data-loop>
  <p class="proof__line">
    {
      live ? (
        <live-counter
          class="proof__count"
          data-base={COUNTER.base}
          data-base-time={COUNTER.baseTime}
          data-per-day={COUNTER.perDay}
          data-endpoint={COUNTER.endpoint}>
          {initial}
        </live-counter>
      ) : (
        <b class="proof__count">{COUNTER.label}</b>
      )
    }{' '}
    {line}
  </p>
  <div class="marquee">
    <ul class="marquee__track" role="list">
      {
        sets.map((set) => (
          <>
            {/* Phones only: the orders line rides in the row, so text and logos are one line. */}
            <li class="marquee__text" aria-hidden={set ? 'true' : undefined}>
              <b>{live ? initial : COUNTER.label}</b> {line}
            </li>
            {CUSTOMER_LOGOS.map((logo) => {
              const height = Math.round(logo.height * 0.66);
              return (
                <li class="marquee__logo" aria-hidden={set ? 'true' : undefined}>
                  <Image src={logo.mono ?? logo.src} alt={set ? '' : logo.name} height={height} densities={retina(logo.mono ?? logo.src)} style={`height:${height}px`} loading="eager" />
                </li>
              );
            })}
          </>
        ))
      }
    </ul>
  </div>
</div>

<script>
  import '../../scripts/live-counter';
</script>

<style>
  .proof {
    display: grid;
    gap: 28px;
    padding-top: 32px;
    border-top: 1px solid var(--line);
  }

  /* Two lines: the figure, then the locations. */
  .proof__line {
    max-width: 27ch;
    text-wrap: balance;
    font-size: var(--step-h4);
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
  }

  .proof__count {
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .marquee {
    overflow: hidden;
  }

  /* Without motion: one set, wrapped, standing still. */
  .marquee__track {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px 48px;
  }

  .marquee__track img {
    width: auto;
    max-width: none;
    /* One light tone for every brand on the dark ground. */
    filter: brightness(0) invert(1);
    opacity: 0.55;
  }

  .marquee__track li[aria-hidden='true'],
  .marquee__text {
    display: none;
  }

  .marquee__text {
    font-size: var(--step-small);
    font-weight: 500;
    white-space: nowrap;
    color: var(--ink-2);
  }

  .marquee__text b {
    font-weight: 700;
    color: var(--ink);
  }

  @media (min-width: 900px) {
    .proof {
      grid-template-columns: minmax(280px, 340px) minmax(0, 1fr);
      align-items: center;
      gap: 48px;
    }
  }

  /* With motion allowed, the logos drift by in a loop that fades out at both edges. */
  @media (prefers-reduced-motion: no-preference) {
    .marquee {
      mask-image: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    }

    .marquee__track {
      flex-wrap: nowrap;
      gap: 0;
      width: max-content;
      animation: marquee 56s linear infinite;
    }

    .marquee__track li {
      padding-inline: clamp(24px, 3vw, 44px);
    }

    .marquee__track li[aria-hidden='true'].marquee__logo {
      display: block;
    }

    .marquee:hover .marquee__track {
      animation-play-state: paused;
    }

    /* Phones: the orders line leaves its own row and rides with the logos, so the band is one line. */
    @media (max-width: 719px) {
      .proof {
        gap: 0;
      }

      .proof__line {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip-path: inset(50%);
        white-space: nowrap;
      }

      .marquee__text,
      .marquee__track li[aria-hidden='true'].marquee__text {
        display: block;
      }

      .marquee__track {
        animation-duration: 44s;
      }
    }
  }

  @keyframes marquee {
    to {
      transform: translateX(-50%);
    }
  }
</style>
