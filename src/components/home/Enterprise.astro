---
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';

const weeks = [
  { when: 'Week 1', title: 'Install and connect', text: 'Mount the verification tablet, connect your cameras and POS, and train Aldente on your menu.' },
  { when: 'Weeks 2–3', title: 'Go live', text: 'Tune accuracy, set up dispute workflows and alert routes, and give Aldo its first Playbooks.' },
  { when: 'Week 4', title: 'Roll out', text: 'Review the first results with your team and plan the next locations.' },
];
---

<section class="enterprise tone-dark section" aria-labelledby="enterprise-title">
  <div class="container enterprise__inner">
    <SectionHeader
      id="enterprise-title"
      title="Built for chains,"
      muted="ready for your first location."
      lead="Live in 30 days with the cameras you already have, and the security your IT team expects."
    />
    <ol class="enterprise__weeks" role="list">
      {
        weeks.map((w) => (
          <Card as="li">
            <span class="enterprise__when">{w.when}</span>
            <h3>{w.title}</h3>
            <p>{w.text}</p>
          </Card>
        ))
      }
    </ol>
    <ul class="enterprise__trust" role="list">
      <Card as="li" class="trust">
        <span class="trust__badge" aria-hidden="true"><b>SOC 2</b><span>Type II</span></span>
        <span><b>SOC 2 Type II certified</b><span>GDPR compliant. Encrypted at rest and in transit.</span></span>
      </Card>
      <Card as="li" class="trust"><span><b>Built for multi-location teams</b><span>Role-based access, regional views and central reporting.</span></span></Card>
      <Card as="li" class="trust"><span><b>Privacy by design</b><span>Repeat-visit counts carry no names. Footage access follows roles, and you set retention.</span></span></Card>
      <Card as="li" class="trust"><span><b>White-glove rollout</b><span>A dedicated success manager and custom SLAs.</span></span></Card>
    </ul>
  </div>
</section>

<style>
  .enterprise__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* One column on phones, two on tablets with the last week across the row, three from 1024px. */
  .enterprise__weeks {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  @media (min-width: 640px) {
    .enterprise__weeks {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .enterprise__weeks > :global(:last-child:nth-child(odd)) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .enterprise__weeks {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .enterprise__weeks > :global(:last-child:nth-child(odd)) {
      grid-column: auto;
    }
  }

  .enterprise__when {
    font-size: var(--step-label);
    font-weight: 600;
    color: var(--fg-accent);
  }

  .enterprise__weeks h3 {
    font-size: var(--step-h4);
    font-weight: 600;
  }

  .enterprise__weeks p {
    color: var(--ink-2);
  }

  .enterprise__trust {
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }

  /* Card is a column by default; trust cards put the badge beside the text. Top-aligned, so every
     card's title sits on the same line. */
  .enterprise__trust :global(.trust) {
    --card-gap: 20px;
    flex: 1 1 280px;
    flex-direction: row;
    align-items: flex-start;
  }

  .trust > span:last-child {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .trust b {
    font-size: var(--step-body);
  }

  .trust > span:last-child span {
    font-size: var(--step-small);
    color: var(--ink-3);
  }

  .trust__badge {
    flex: none;
    width: 76px;
    height: 76px;
    border-radius: 50%;
    border: 2px solid var(--ink);
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    line-height: 1.05;
  }

  .trust__badge span {
    font-size: var(--step-label);
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }
</style>
