---
import Card from '../ui/Card.astro';
import Icon, { type IconName } from '../ui/Icon.astro';
import RolloutWeeks from '../ui/RolloutWeeks.astro';
import SectionHeader from '../ui/SectionHeader.astro';

// What IT and operations ask before the first location goes live.
const trust: { icon: IconName; title: string; text: string }[] = [
  { icon: 'lock', title: 'Encrypted, GDPR compliant', text: 'Footage and records are encrypted at rest and in transit.' },
  { icon: 'users', title: 'Built for multi-location teams', text: 'Role-based access, regional views and central reporting.' },
  { icon: 'shield-check', title: 'Privacy by design', text: 'Repeat-visit counts carry no names. You set who sees footage and how long it is kept.' },
  { icon: 'user-check', title: 'White-glove rollout', text: 'A dedicated success manager and custom SLAs.' },
];
---

<section class="enterprise tone-dark section" aria-labelledby="enterprise-title">
  <div class="container enterprise__inner">
    <SectionHeader
      id="enterprise-title"
      label="How we start"
      title="Built for chains,"
      muted="ready for your first location."
      lead="Live in 2–3 weeks with the cameras you already have, and the security your IT team expects."
    />
    <RolloutWeeks />
    <ul class="enterprise__trust" role="list">
      {
        trust.map((t) => (
          <Card as="li" class="trust">
            <span class="trust__icon" aria-hidden="true">
              <Icon name={t.icon} size={18} />
            </span>
            <span class="trust__copy">
              <b>{t.title}</b>
              <span>{t.text}</span>
            </span>
          </Card>
        ))
      }
    </ul>
  </div>
</section>

<style>
  .enterprise__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* Four short answers to what IT and operations ask: one column on phones, two on tablets, four from 1024px. */
  .enterprise__trust {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  @media (min-width: 640px) {
    .enterprise__trust {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (min-width: 1024px) {
    .enterprise__trust {
      grid-template-columns: repeat(4, minmax(0, 1fr));
    }
  }

  .enterprise__trust :global(.trust) {
    --card-gap: 16px;
  }

  .trust__icon {
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    border-radius: var(--radius-s);
    background: var(--card-2);
    color: var(--fg);
  }

  .trust__copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .trust__copy b {
    font-size: var(--step-body);
    font-weight: 600;
    line-height: 1.3;
  }

  .trust__copy span {
    font-size: var(--step-small);
    color: var(--fg-3);
  }
</style>
