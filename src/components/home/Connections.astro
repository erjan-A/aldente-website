---
import mark from '../../assets/logos/aldente-mark.svg';
import type { ProductId } from '../../data/products';
import Icon, { type IconName } from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';

/**
 * Aldo in the middle of the restaurant's data, as on the sales deck: Aldente Verify, Dispute and Vision and
 * the customer's own systems feed Aldo, and Aldo answers in Slack with Q&A and Playbooks. Dots of light run
 * along the wires into Aldo and out to Slack, and the lit hub breathes (all still for reduced motion). Wide
 * screens draw the wires; the geometry is fixed (row heights below), so the SVG paths meet each row at its
 * centre without measuring anything in the browser. Stacked screens join the blocks with two short lines.
 * The glow is a gradient that fades to nothing inside its own box, never a large box-shadow, which Safari
 * clips to a visible square.
 */
interface Props {
  /** Add top spacing when the section follows a different tone. */
  padTop?: boolean;
  /** The product pill over the heading; null on Aldo's own page. */
  product?: ProductId | null;
}

const { padTop = false, product = 'aldo' } = Astro.props;

interface Source {
  name: string;
  detail?: string;
  icon: IconName;
}

const products: Source[] = [
  { name: 'Aldente Verify', detail: 'Orders and photo evidence', icon: 'check-check' },
  { name: 'Aldente Dispute', detail: 'Refund claims and evidence packs', icon: 'shield-check' },
  { name: 'Aldente Vision', detail: 'Camera events and metrics', icon: 'eye' },
];

const systems: Source[] = [
  { name: 'POS', detail: 'Sales and orders', icon: 'receipt' },
  { name: 'HR and time clock', detail: 'Shifts and clock-outs', icon: 'clock' },
  { name: 'Inventory and procurement', detail: 'Stock levels and purchasing', icon: 'package' },
  { name: 'Other customer systems', icon: 'database' },
];

const outputs: { name: string; detail: string; icon: IconName; ask: string; answer: string }[] = [
  { name: 'Q&A', detail: 'Ask for what you need', icon: 'message-square', ask: 'How many visitors yesterday?', answer: '3,499, up 4%.' },
  {
    name: 'Playbooks',
    detail: 'Repeat a task in the background',
    icon: 'repeat',
    ask: 'Check clock-outs after closing.',
    answer: '1 missing clock-out, with the clip.',
  },
];

// Fixed geometry for the wired layout (px). Left column: a group label, the products, a gap, a label, the
// systems. Right column: a label and two cards, centred in the same height. Must match the CSS below.
const LABEL = 32;
const NODE = 56;
const GAP = 8;
const GROUP_GAP = 20;
const CARD = 196;
const CARD_GAP = 16;
const block = (n: number) => n * NODE + (n - 1) * GAP;
const HEIGHT = LABEL + block(products.length) + GROUP_GAP + LABEL + block(systems.length);
const MID = HEIGHT / 2;
const RIGHT_TOP = (HEIGHT - (LABEL + 2 * CARD + CARD_GAP)) / 2;

const productY = products.map((_, i) => LABEL + i * (NODE + GAP) + NODE / 2);
const systemsTop = LABEL + block(products.length) + GROUP_GAP + LABEL;
const systemY = systems.map((_, i) => systemsTop + i * (NODE + GAP) + NODE / 2);
const outputY = outputs.map((_, i) => RIGHT_TOP + LABEL + i * (CARD + CARD_GAP) + CARD / 2);

const wireIn = (y: number) => `M0 ${y} C55 ${y} 45 ${MID} 100 ${MID}`;
const wireOut = (y: number) => `M0 ${MID} C55 ${MID} 45 ${y} 100 ${y}`;
// Each wire carries a dot of light, staggered so the dots never move as one.
const inWires = [...productY, ...systemY];
const delay = (i: number, n: number) => `${(-(i / n) * 2.4).toFixed(2)}s`;
---

<section class:list={['connections', 'tone-dark', { 'connections--pad': padTop }]} aria-labelledby="connections-title">
  <div class="container connections__inner">
    <SectionHeader
      product={product ?? undefined}
      label={product === 'aldo' ? 'Aldo in Slack' : undefined}
      id="connections-title"
      title="Aldo works in Slack,"
      muted="with data from Verify, Dispute, Vision and your systems."
      lead="Aldente Verify, Dispute and Vision give Aldo eyes in every location. Connect your POS, HR and inventory systems, and it answers with the whole picture."
    />

    <div class="map" style={`--map-h:${HEIGHT}px;--right-top:${RIGHT_TOP}px`}>
      <div class="map__in">
        {/* Group labels, not headings: they name the lists under them. */}
        <p class="map__label" id="map-products">Aldente products</p>
        <ul class="map__list" role="list" aria-labelledby="map-products">
          {
            products.map((s) => (
              <li class="node node--product">
                <Icon name={s.icon} size={20} />
                <span>
                  <b>{s.name}</b>
                  {s.detail && <small>{s.detail}</small>}
                </span>
              </li>
            ))
          }
        </ul>
        <p class="map__label map__label--gap" id="map-systems">Your systems</p>
        <ul class="map__list" role="list" aria-labelledby="map-systems">
          {
            systems.map((s) => (
              <li class="node">
                <Icon name={s.icon} size={20} />
                <span>
                  <b>{s.name}</b>
                  {s.detail && <small>{s.detail}</small>}
                </span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="map__wires map__wires--in" aria-hidden="true">
        <svg viewBox={`0 0 100 ${HEIGHT}`} preserveAspectRatio="none" focusable="false">
          {inWires.map((y) => <path class="wire wire--in" d={wireIn(y)} />)}
          {
            inWires.map((y, i) => (
              <path class="pulse" d={wireIn(y)} pathLength="100" style={`animation-delay:${delay(i, inWires.length)}`} />
            ))
          }
        </svg>
      </div>

      <div class="map__hub">
        <span class="hub__glow" aria-hidden="true"></span>
        <span class="hub__line hub__line--in" aria-hidden="true"><i></i></span>
        <div class="hub">
          <span class="hub__halo" aria-hidden="true"></span>
          <span class="hub__ring" aria-hidden="true"></span>
          <span class="hub__ripple" aria-hidden="true"></span>
          <img src={mark.src} alt="" width="40" height="49" />
          <b>Aldo</b>
          <small>AI Chief of Staff</small>
        </div>
        <span class="hub__line hub__line--out" aria-hidden="true"><i></i></span>
      </div>

      <div class="map__wires map__wires--out" aria-hidden="true">
        <svg viewBox={`0 0 100 ${HEIGHT}`} preserveAspectRatio="none" focusable="false">
          {outputY.map((y) => <path class="wire wire--out" d={wireOut(y)} />)}
          {
            outputY.map((y, i) => (
              <path class="pulse pulse--out" d={wireOut(y)} pathLength="100" style={`animation-delay:${delay(i, outputY.length)}`} />
            ))
          }
        </svg>
      </div>

      <div class="map__out">
        <p class="map__label map__label--slack" id="map-slack"><Icon name="hash" size={18} strokeWidth={2} />In Slack</p>
        <ul class="map__cards" role="list" aria-labelledby="map-slack">
          {
            outputs.map((o) => (
              <li class="out">
                <div class="out__head">
                  <Icon name={o.icon} size={22} />
                  <span>
                    <b>{o.name}</b>
                    <small>{o.detail}</small>
                  </span>
                </div>
                <p class="out__bubble">
                  <span class="out__ask">“{o.ask}”</span>
                  <span class="out__answer">
                    <b>Aldo:</b> {o.answer}
                  </span>
                </p>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<style>
  .connections {
    padding-bottom: var(--section-y);
  }

  .connections--pad {
    padding-top: var(--section-y);
  }

  .connections__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(40px, 5vw, 64px);
  }

  /* ---------- Stacked (phones, tablets): sources, Aldo, then Slack ---------- */

  .map {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .map__in,
  .map__out {
    display: flex;
    flex-direction: column;
  }

  .map__label {
    display: flex;
    align-items: center;
    gap: 8px;
    height: 32px;
    padding-bottom: 8px;
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--ink-3);
  }

  .map__label--gap {
    margin-top: 20px;
  }

  .map__label--slack {
    color: var(--ink);
  }

  .map__label--slack :global(svg) {
    color: var(--accent);
  }

  .map__list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
    gap: 8px;
  }

  .node {
    position: relative;
    display: flex;
    align-items: center;
    gap: 14px;
    min-height: 56px;
    padding: 8px 16px;
    border-radius: var(--radius-m);
    background: var(--surface);
    border: 1px solid var(--line-card);
    color: var(--ink-2);
  }

  .node--product {
    border-color: rgb(224 86 52 / 0.6);
    color: var(--accent);
  }

  .node > span {
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .node b {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.25;
    color: var(--ink);
  }

  .node small {
    font-size: var(--step-small);
    line-height: 1.3;
    color: var(--ink-3);
  }

  .map__wires {
    display: none;
  }

  /* Stacked: a dashed line from the sources into Aldo, a solid one out to Slack, each ending in a port. */
  .map__hub {
    position: relative;
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: -8px;
  }

  /* As wide as a phone at most, so tablets get a round glow rather than a flat band. */
  .hub__glow {
    position: absolute;
    top: 0;
    bottom: 0;
    left: 50%;
    width: min(100%, 380px);
    translate: -50% 0;
    background: radial-gradient(closest-side, rgb(224 86 52 / 0.24), rgb(224 86 52 / 0.08) 55%, transparent);
    pointer-events: none;
  }

  .hub__line {
    position: relative;
    width: 2px;
    height: 56px;
    --port: 0;
  }

  .hub__line--in {
    background: repeating-linear-gradient(to bottom, var(--accent) 0 5px, transparent 5px 10px);
  }

  .hub__line--out {
    --port: 100%;
    background: var(--accent);
  }

  .hub__line::before {
    content: '';
    position: absolute;
    left: 50%;
    top: var(--port);
    width: 8px;
    height: 8px;
    border-radius: 50%;
    background: var(--accent);
    translate: -50% -50%;
  }

  /* The dot of light that runs down each line (motion only). */
  .hub__line i {
    display: none;
    position: absolute;
    left: 50%;
    top: -3px;
    width: 6px;
    height: 6px;
    margin-left: -3px;
    border-radius: 50%;
    background: #ffb08f;
    box-shadow: 0 0 8px 2px rgb(224 86 52 / 0.9);
  }

  .hub {
    position: relative;
    width: 148px;
    aspect-ratio: 1;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 4px;
    border-radius: 50%;
    background: radial-gradient(circle at 50% 0%, #4a2213 0%, var(--bg) 72%);
    border: 2px solid var(--accent);
    box-shadow:
      0 0 28px rgb(224 86 52 / 0.4),
      inset 0 0 22px rgb(224 86 52 / 0.14);
  }

  /* The design system's lit circle: a ring close in, a fainter halo further out, and one ripple between. */
  .hub__halo,
  .hub__ring,
  .hub__ripple {
    position: absolute;
    border-radius: 50%;
    pointer-events: none;
  }

  .hub__ring {
    inset: -14px;
    border: 1px solid rgb(224 86 52 / 0.45);
  }

  .hub__halo {
    inset: -34px;
    border: 1px solid rgb(224 86 52 / 0.18);
  }

  .hub__ripple {
    inset: -2px;
    border: 1px solid rgb(224 86 52 / 0.5);
    opacity: 0;
  }

  .hub img {
    width: 34px;
    height: auto;
    margin-bottom: 4px;
  }

  .hub b {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.2;
  }

  .hub small {
    font-size: var(--step-label);
    color: var(--ink-2);
  }

  .map__cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
    gap: 12px;
  }

  .out {
    position: relative;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 14px;
    padding: 18px 18px 18px 20px;
    border-radius: var(--radius-l);
    background: rgb(224 86 52 / 0.08);
    border: 1px solid rgb(224 86 52 / 0.6);
  }

  .out__head {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    color: var(--accent);
  }

  .out__head :global(svg) {
    flex: none;
    margin-top: 3px;
  }

  .out__head span {
    display: flex;
    flex-direction: column;
  }

  .out__head b {
    font-size: var(--step-h4);
    font-weight: 600;
    line-height: 1.2;
    color: var(--ink);
  }

  .out__head small {
    font-size: var(--step-small);
    color: var(--ink-2);
  }

  /* The exchange, as a white Slack-style bubble. */
  .out__bubble {
    display: flex;
    flex-direction: column;
    gap: 4px;
    padding: 12px 16px;
    border-radius: var(--radius-m);
    background: var(--paper-card);
    color: var(--paper-ink);
    font-size: var(--step-small);
    line-height: 1.4;
  }

  .out__ask {
    color: var(--paper-ink-2);
  }

  .out__answer {
    font-size: 1.0625rem;
  }

  /* ---------- Wired (wide screens): sources → Aldo → Slack, like the deck ---------- */
  @media (min-width: 1080px) {
    .map {
      display: grid;
      grid-template-columns: minmax(300px, 360px) minmax(48px, 1fr) 208px minmax(48px, 1fr) minmax(320px, 400px);
      height: var(--map-h);
      gap: 0;
    }

    .map__list {
      grid-template-columns: minmax(0, 1fr);
    }

    /* Rows at exactly the heights the wire geometry assumes. */
    .node {
      height: 56px;
      min-height: 0;
      padding-block: 0;
    }

    .node small {
      font-size: var(--step-label);
    }

    .map__wires {
      display: block;
      position: relative;
    }

    .map__wires svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .map__hub {
      justify-content: center;
      margin-top: 0;
    }

    .hub__line {
      display: none;
    }

    .hub__glow {
      top: 50%;
      bottom: auto;
      width: 520px;
      aspect-ratio: 1;
      translate: -50% -50%;
    }

    .hub {
      width: 208px;
      gap: 6px;
    }

    .hub__ring {
      inset: -18px;
    }

    .hub__halo {
      inset: -48px;
    }

    .hub img {
      width: 40px;
    }

    .hub b {
      font-size: 1.5rem;
    }

    .hub small {
      font-size: var(--step-small);
    }

    .map__out {
      padding-top: var(--right-top);
    }

    .map__cards {
      grid-template-columns: minmax(0, 1fr);
      gap: 16px;
    }

    .out {
      height: 196px;
    }

    /* Ports where the wires meet the rows. */
    .node::after,
    .out::before {
      content: '';
      position: absolute;
      top: 50%;
      width: 8px;
      height: 8px;
      margin-top: -4px;
      border-radius: 50%;
      background: var(--accent);
    }

    .node::after {
      right: -4px;
    }

    .out::before {
      left: -4px;
    }
  }

  .wire {
    fill: none;
    stroke: var(--accent);
    vector-effect: non-scaling-stroke;
  }

  .wire--in {
    stroke-width: 1.5;
    stroke-dasharray: 3 5;
    opacity: 0.85;
  }

  .wire--out {
    stroke-width: 2;
  }

  /* A dot of light on each wire: a zero-length dash with a round cap, walked along the path. */
  .pulse {
    display: none;
    fill: none;
    stroke: #ffb08f;
    stroke-width: 6;
    stroke-linecap: round;
    stroke-dasharray: 0 100;
    vector-effect: non-scaling-stroke;
    filter: drop-shadow(0 0 4px rgb(224 86 52 / 0.9));
  }

  @media (prefers-reduced-motion: no-preference) {
    .wire--in {
      animation: wire-flow 1.2s linear infinite;
    }

    .pulse {
      display: inline;
      animation: pulse-in 2.4s cubic-bezier(0.45, 0, 0.55, 1) infinite both;
    }

    .pulse--out {
      animation-name: pulse-out;
    }

    .hub__glow {
      animation: glow-breathe 4.8s ease-in-out infinite;
    }

    .hub__ripple {
      animation: hub-ripple 4.8s ease-out infinite;
    }

    .hub__line--in {
      animation: line-flow 1.2s linear infinite;
    }

    .hub__line i {
      display: block;
      animation: line-dot 2.4s linear infinite both;
    }

    /* Out of Aldo once the dot coming in has arrived. */
    .hub__line--out i {
      animation-delay: 1.2s;
    }
  }

  @keyframes wire-flow {
    to {
      stroke-dashoffset: -16;
    }
  }

  @keyframes pulse-in {
    0% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    12%,
    88% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }

  /* Out of Aldo once the dots coming in have arrived. */
  @keyframes pulse-out {
    0%,
    40% {
      stroke-dashoffset: 0;
      opacity: 0;
    }
    50%,
    92% {
      opacity: 1;
    }
    100% {
      stroke-dashoffset: -100;
      opacity: 0;
    }
  }

  @keyframes glow-breathe {
    0%,
    100% {
      opacity: 0.75;
    }
    50% {
      opacity: 1;
    }
  }

  @keyframes hub-ripple {
    0% {
      transform: scale(1);
      opacity: 0.55;
    }
    100% {
      transform: scale(1.42);
      opacity: 0;
    }
  }

  @keyframes line-flow {
    to {
      background-position: 0 10px;
    }
  }

  /* Each dot takes half the cycle, so the one going out leaves as the one coming in arrives. */
  @keyframes line-dot {
    0% {
      transform: translateY(0);
      opacity: 0;
    }
    8%,
    42% {
      opacity: 1;
    }
    50%,
    100% {
      transform: translateY(56px);
      opacity: 0;
    }
  }
</style>
