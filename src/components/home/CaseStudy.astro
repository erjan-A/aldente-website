---
import Card from '../ui/Card.astro';
import ProductPill from '../ui/ProductPill.astro';

/**
 * Customer results, four numbers and no more: the volume (~200 orders a day) under the claim, the error rate
 * and the wrong orders a day leading each card, and the money saved. The footnote carries the average check
 * and the maths. Each card's 16 dots are wrong orders a day: 14 to 16 before (the last two lighter, the
 * range), about 2 with Aldente. The operator's words follow as one wide card.
 */
const SLOTS = 16;
const before = Array.from({ length: SLOTS }, (_, i) => (i < 14 ? 'on' : 'maybe'));
const after = Array.from({ length: SLOTS }, (_, i) => (i < 2 ? 'on' : ''));
---

<section class="case tone-paper section" id="customers" aria-labelledby="case-title">
  <div class="container case__inner">
    <div class="case__top">
      <div class="case__story">
        <ProductPill label="Customer results" />
        <h2 id="case-title" class="case__title">Most wrong orders stop at the packing station.</h2>
        <p class="case__figure"><b>87%</b> fewer wrong orders</p>
        <p class="case__volume"><b>~200</b> delivery and drive-thru orders a day, at one location of a regional restaurant chain.</p>
        <p class="case__saved"><b>$74K+</b> saved a year at this location.*</p>
        <p class="case__note">* 12 fewer wrong orders a day × 365 days × $17 average check, with a full refund for each wrong order.</p>
      </div>

      <div class="case__compare">
        <Card as="figure" pad="l" class="case__panel">
          <figcaption>Before Aldente</figcaption>
          <p class="case__rate"><b>7–8%</b><span>error rate</span></p>
          <div class="dots" role="img" aria-label="14 to 16 wrong orders a day before Aldente">
            {before.map((state) => <i class={state} />)}
          </div>
          <p class="case__day"><b>14–16</b> wrong orders a day</p>
        </Card>
        <Card as="figure" pad="l" class="case__panel case__panel--after">
          <figcaption>With Aldente</figcaption>
          <p class="case__rate"><b>~1%</b><span>error rate</span></p>
          <div class="dots" role="img" aria-label="About 2 wrong orders a day with Aldente">
            {after.map((state) => <i class={state || undefined} />)}
          </div>
          <p class="case__day"><b>~2</b> wrong orders a day</p>
        </Card>
      </div>
    </div>

    <figure class="case__quote">
      <span class="case__mark" aria-hidden="true">“</span>
      <blockquote>
        Every wrong order meant a full refund. Aldente put a camera at the packing station and trained it on our menu. Now every bag
        is checked before the courier takes it, and nobody wants to go back.
      </blockquote>
      <figcaption><b>Director of Operations</b> · Regional QSR chain</figcaption>
    </figure>
  </div>
</section>

<style>
  .case__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .case__top {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .case__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 72px;
    }
  }

  .case__story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 20px;
  }

  /* The section H2 step (as SectionHeader), with the figure in orange. */
  .case__title {
    max-width: 16ch;
    font-size: var(--step-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  /* The result: the figure in the one figure size, the words beside it. */
  .case__figure {
    display: flex;
    align-items: baseline;
    flex-wrap: wrap;
    gap: 4px 12px;
    font-size: var(--step-h4);
    font-weight: 600;
    line-height: 1.2;
    color: var(--fg);
  }

  .case__figure b {
    font-size: var(--step-stat);
    font-weight: 700;
    line-height: 1;
    letter-spacing: -0.03em;
    color: var(--fg-accent);
    font-variant-numeric: tabular-nums;
  }

  /* The volume and the saving: one line each, the figure in full ink and weight, the rest quieter. */
  .case__volume,
  .case__saved {
    max-width: 30ch;
    font-size: var(--step-h4);
    line-height: 1.4;
    color: var(--fg-2);
  }

  .case__volume b,
  .case__saved b {
    color: var(--fg);
    font-weight: 700;
    font-variant-numeric: tabular-nums;
  }

  .case__saved {
    padding-top: 16px;
    border-top: 1px solid var(--card-line);
  }

  .case__note {
    max-width: 52ch;
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--fg-3);
  }

  .case__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  /* Each panel is a Card (figure). */
  .case__panel {
    --card-gap: 16px;
    margin: 0;
  }

  .case__panel figcaption {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--fg-3);
  }

  /* The error rate leads each card; the wrong orders a day sit under the dots, number first. */
  .case__rate {
    display: flex;
    flex-direction: column;
    gap: 8px;
  }

  .case__rate b {
    font-size: var(--step-stat);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .case__rate span,
  .case__day {
    font-size: var(--step-small);
    line-height: 1.4;
    color: var(--fg-2);
  }

  .case__day b {
    font-size: var(--step-h4);
    font-weight: 700;
    color: var(--fg);
    font-variant-numeric: tabular-nums;
  }

  /* The "after" panel is the dark one: the Card reads these roles. */
  .case__panel--after {
    --card: var(--bg);
    --card-line: var(--bg);
    --fg: var(--ink);
  }

  .case__panel--after figcaption {
    color: var(--ok);
  }

  .case__panel--after .case__rate span,
  .case__panel--after .case__day {
    color: var(--ink-2);
  }

  .case__panel--after .case__day b {
    color: var(--ink);
  }

  /* One dot per wrong order a day, two rows of eight. */
  .dots {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: clamp(4px, 0.6vw, 8px);
    max-width: 232px;
  }

  .dots i {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper-dot);
  }

  .case__panel--after .dots i {
    background: var(--line-card);
  }

  .case__panel .dots i.on {
    background: var(--accent);
  }

  /* The top of the 14 to 16 range. */
  .case__panel .dots i.maybe {
    background: color-mix(in srgb, var(--accent) 35%, transparent);
  }

  /* The operator's words: one card across both columns, the mark beside the quote. */
  .case__quote {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(16px, 2.4vw, 32px);
    row-gap: 16px;
    padding: var(--card-pad-l);
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .case__mark {
    grid-row: span 2;
    font-size: var(--step-h1);
    font-weight: 700;
    line-height: 0.8;
    color: var(--accent);
  }

  .case__quote blockquote {
    max-width: 60ch;
    margin: 0;
    font-size: var(--step-h4);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .case__quote figcaption {
    font-size: var(--step-small);
    color: var(--fg-3);
  }

  .case__quote figcaption b {
    font-weight: 600;
    color: var(--fg);
  }

  /* Phones: the mark above the words. */
  @media (max-width: 599px) {
    .case__quote {
      grid-template-columns: minmax(0, 1fr);
    }

    .case__mark {
      grid-row: auto;
      font-size: var(--step-stat);
      line-height: 0.6;
    }
  }
</style>
