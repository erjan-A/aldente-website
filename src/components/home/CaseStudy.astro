---
import ProductPill from '../ui/ProductPill.astro';

// The numbers and the footnote match the decks' "Customer results" slide.
const BEFORE_ERRORS = new Set([3, 17, 28, 41, 55, 66, 79, 92]);
const AFTER_ERRORS = new Set([55]);
const dots = Array.from({ length: 100 }, (_, i) => i);
---

<section class="case tone-paper section" id="customers" aria-labelledby="case-title">
  <div class="container case__inner">
    <div class="case__story">
      <ProductPill label="Customer results" />
      <h2 id="case-title" class="case__title"><span class="case__accent">87% fewer</span> wrong orders.</h2>
      <p class="case__context">At one location of a regional restaurant chain, with about 200 delivery and drive-thru orders a day and a $17 average check.</p>
      <p class="case__result">That’s <b>4,300+ fewer wrong orders</b> and <b>$74K+ saved</b> a year.*</p>
      <p class="case__note">* 12 fewer wrong orders a day × 365 days × $17 average check, with a full refund for each wrong order.</p>
    </div>

    <div class="case__compare">
      <figure class="case__panel">
        <figcaption><span>Before Aldente</span><b>7–8%</b></figcaption>
        <div class="dots" role="img" aria-label="About 8 wrong orders in every 100 before Aldente">
          {dots.map((i) => <i class:list={{ on: BEFORE_ERRORS.has(i) }} />)}
        </div>
        <p>14–16 wrong orders a day</p>
      </figure>
      <figure class="case__panel case__panel--after">
        <figcaption><span>With Aldente</span><b>~1%</b></figcaption>
        <div class="dots" role="img" aria-label="About 1 wrong order in every 100 with Aldente">
          {dots.map((i) => <i class:list={{ on: AFTER_ERRORS.has(i) }} />)}
        </div>
        <p>~2 wrong orders a day</p>
      </figure>
    </div>
  </div>
</section>

<style>
  .case__inner {
    display: flex;
    flex-wrap: wrap;
    gap: 56px;
    align-items: center;
  }

  .case__story {
    flex: 1 1 420px;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  /* The section H2 step (as SectionHeader), with the figure in orange. */
  .case__title {
    max-width: 12ch;
    font-size: var(--step-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .case__accent {
    color: var(--accent);
  }

  .case__context {
    max-width: 40ch;
    font-size: 1.125rem;
    color: var(--fg-2);
  }

  .case__result {
    max-width: 40ch;
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .case__note {
    max-width: 48ch;
    font-size: var(--step-small);
    color: var(--fg-3);
  }

  .case__compare {
    flex: 1 1 460px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  @media (max-width: 600px) {
    .case__panel {
      gap: 14px;
    }

    .dots {
      gap: 4px;
    }
  }

  .case__panel {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 20px;
    padding: var(--card-pad-m);
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .case__panel figcaption {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .case__panel figcaption span {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--fg-3);
  }

  .case__panel figcaption b {
    font-size: clamp(2.5rem, 2rem + 1.6vw, 3.5rem);
    letter-spacing: -0.03em;
    line-height: 1;
  }

  .case__panel p {
    font-size: var(--step-small);
    color: var(--fg-2);
  }

  .case__panel--after {
    background: var(--bg);
    border-color: var(--bg);
    color: var(--ink);
  }

  .case__panel--after figcaption span {
    color: var(--ok);
  }

  .case__panel--after p {
    color: var(--ink-2);
  }

  .dots {
    display: grid;
    grid-template-columns: repeat(10, minmax(0, 1fr));
    gap: 6px;
  }

  .dots i {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper-dot);
  }

  .case__panel--after .dots i {
    background: var(--line);
  }

  .dots i.on {
    background: var(--accent) !important;
  }
</style>
