---
import ProductPill from '../ui/ProductPill.astro';

/**
 * Customer results, laid out like the decks' slide: the claim and the operator's words on the left, before and
 * after as wrong orders a day on the right. Each card holds 16 dots, one per wrong order: 14 to 16 before (the
 * last two lighter, the range), about 2 with Aldente. The numbers and the footnote match the slide.
 */
const SLOTS = 16;
const before = Array.from({ length: SLOTS }, (_, i) => (i < 14 ? 'on' : 'maybe'));
const after = Array.from({ length: SLOTS }, (_, i) => (i < 2 ? 'on' : ''));
---

<section class="case tone-paper section" id="customers" aria-labelledby="case-title">
  <div class="container case__inner">
    <div class="case__story">
      <ProductPill label="Customer results" />
      <h2 id="case-title" class="case__title"><span class="case__accent">87% fewer</span> wrong orders at one location.</h2>
      <figure class="case__quote">
        <blockquote>
          “We had 14 to 16 wrong delivery and drive-thru orders a day, and every one meant a full refund. Aldente put a tablet at the
          packing station and trained it on our menu. Now we’re at about 2 a day, and nobody wants to go back.”
        </blockquote>
        <figcaption><b>Director of Operations</b> · Regional QSR chain</figcaption>
      </figure>
    </div>

    <div class="case__side">
      <div class="case__compare">
        <figure class="case__panel">
          <figcaption>Before Aldente</figcaption>
          <b class="case__figure">14–16</b>
          <div class="dots" role="img" aria-label="14 to 16 wrong orders a day before Aldente">
            {before.map((state) => <i class={state} />)}
          </div>
          <p>wrong orders a day (7–8%)</p>
        </figure>
        <figure class="case__panel case__panel--after">
          <figcaption>With Aldente</figcaption>
          <b class="case__figure">~2</b>
          <div class="dots" role="img" aria-label="About 2 wrong orders a day with Aldente">
            {after.map((state) => <i class={state || undefined} />)}
          </div>
          <p>wrong orders a day (~1%)</p>
        </figure>
      </div>
      <p class="case__note">
        About 200 delivery and drive-thru orders a day, $17 average check. 12 fewer wrong orders × 365 days × $17 = $74K+ a year at one
        store, with a full refund for each wrong order.
      </p>
    </div>
  </div>
</section>

<style>
  .case__inner {
    display: grid;
    gap: 48px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .case__inner {
      grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
      gap: 72px;
    }
  }

  .case__story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 28px;
  }

  /* The section H2 step (as SectionHeader), with the figure in orange. */
  .case__title {
    max-width: 13ch;
    font-size: var(--step-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .case__accent {
    color: var(--accent);
  }

  .case__quote {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  /* The bar marks the words only; the attribution sits under it, flush with the bar. */
  .case__quote blockquote {
    max-width: 44ch;
    margin: 0;
    padding-left: 24px;
    border-left: 3px solid var(--accent);
    font-size: var(--step-lead);
    line-height: 1.5;
    color: var(--fg-2);
  }

  .case__quote figcaption {
    font-size: var(--step-small);
    color: var(--fg-3);
  }

  .case__quote figcaption b {
    font-weight: 600;
    color: var(--fg);
  }

  .case__side {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .case__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .case__panel {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(20px, 2.4vw, 32px);
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .case__panel figcaption {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--fg-3);
  }

  .case__figure {
    font-size: clamp(2.5rem, 1.9rem + 2vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .case__panel p {
    font-size: var(--step-small);
    line-height: 1.4;
    color: var(--fg-2);
  }

  .case__panel--after {
    background: var(--bg);
    border-color: var(--bg);
    color: var(--ink);
  }

  .case__panel--after figcaption {
    color: var(--ok);
  }

  .case__panel--after p {
    color: var(--ink-2);
  }

  /* One dot per wrong order a day, two rows of eight. */
  .dots {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: clamp(4px, 0.6vw, 7px);
    max-width: 232px;
  }

  .dots i {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper-dot);
  }

  .case__panel--after .dots i {
    background: var(--line-card);
  }

  .case__panel .dots i.on {
    background: var(--accent);
  }

  /* The top of the 14 to 16 range. */
  .case__panel .dots i.maybe {
    background: rgb(224 86 52 / 0.35);
  }

  .case__note {
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--fg-3);
  }
</style>
