---
import ProductPill from '../ui/ProductPill.astro';

/**
 * Customer results: the decks' figures and footnote beside the before/after cards, then the operator's words
 * as one wide card under both, so the two columns stay the same height. Each card holds 16 dots, one per
 * wrong order a day: 14 to 16 before (the last two lighter, the range), about 2 with Aldente.
 */
const SLOTS = 16;
const before = Array.from({ length: SLOTS }, (_, i) => (i < 14 ? 'on' : 'maybe'));
const after = Array.from({ length: SLOTS }, (_, i) => (i < 2 ? 'on' : ''));
---

<section class="case tone-paper section" id="customers" aria-labelledby="case-title">
  <div class="container case__inner">
    <div class="case__top">
      <div class="case__story">
        <ProductPill label="Customer results" />
        <h2 id="case-title" class="case__title"><span class="case__accent">87% fewer</span> wrong orders.</h2>
        <p class="case__context">At one location of a regional restaurant chain, with about 200 delivery and drive-thru orders a day and a $17 average check.</p>
        <p class="case__result">That’s <b>4,300+ fewer wrong orders</b> and <b>$74K+ saved</b> a year.*</p>
        <p class="case__note">* 12 fewer wrong orders a day × 365 days × $17 average check, with a full refund for each wrong order.</p>
      </div>

      <div class="case__compare">
        <figure class="case__panel">
          <figcaption>Before Aldente</figcaption>
          <b class="case__figure">7–8%</b>
          <div class="dots" role="img" aria-label="14 to 16 wrong orders a day before Aldente">
            {before.map((state) => <i class={state} />)}
          </div>
          <p>14–16 wrong orders a day</p>
        </figure>
        <figure class="case__panel case__panel--after">
          <figcaption>With Aldente</figcaption>
          <b class="case__figure">~1%</b>
          <div class="dots" role="img" aria-label="About 2 wrong orders a day with Aldente">
            {after.map((state) => <i class={state || undefined} />)}
          </div>
          <p>~2 wrong orders a day</p>
        </figure>
      </div>
    </div>

    <figure class="case__quote">
      <span class="case__mark" aria-hidden="true">“</span>
      <blockquote>
        We had 14 to 16 wrong delivery and drive-thru orders a day, and every one meant a full refund. Aldente put a tablet at the
        packing station and trained it on our menu. Now we’re at about 2 a day, and nobody wants to go back.
      </blockquote>
      <figcaption><b>Director of Operations</b> · Regional QSR chain</figcaption>
    </figure>
  </div>
</section>

<style>
  .case__inner {
    display: flex;
    flex-direction: column;
    gap: clamp(32px, 4vw, 48px);
  }

  .case__top {
    display: grid;
    gap: 40px;
    align-items: center;
  }

  @media (min-width: 1024px) {
    .case__top {
      grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
      gap: 72px;
    }
  }

  .case__story {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 24px;
  }

  /* The section H2 step (as SectionHeader), with the figure in orange. */
  .case__title {
    max-width: 12ch;
    font-size: var(--step-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  .case__accent {
    color: var(--accent);
  }

  .case__context {
    max-width: 44ch;
    font-size: 1.125rem;
    color: var(--fg-2);
  }

  .case__result {
    max-width: 40ch;
    font-size: 1.25rem;
    line-height: 1.45;
  }

  .case__note {
    max-width: 52ch;
    font-size: var(--step-small);
    line-height: 1.5;
    color: var(--fg-3);
  }

  .case__compare {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 12px;
  }

  .case__panel {
    margin: 0;
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: clamp(20px, 2.4vw, 32px);
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .case__panel figcaption {
    font-size: var(--step-small);
    font-weight: 600;
    color: var(--fg-3);
  }

  .case__figure {
    font-size: clamp(2.5rem, 1.9rem + 2vw, 3.75rem);
    font-weight: 700;
    letter-spacing: -0.03em;
    line-height: 1;
    font-variant-numeric: tabular-nums;
  }

  .case__panel p {
    font-size: var(--step-small);
    line-height: 1.4;
    color: var(--fg-2);
  }

  .case__panel--after {
    background: var(--bg);
    border-color: var(--bg);
    color: var(--ink);
  }

  .case__panel--after figcaption {
    color: var(--ok);
  }

  .case__panel--after p {
    color: var(--ink-2);
  }

  /* One dot per wrong order a day, two rows of eight. */
  .dots {
    display: grid;
    grid-template-columns: repeat(8, minmax(0, 1fr));
    gap: clamp(4px, 0.6vw, 7px);
    max-width: 232px;
  }

  .dots i {
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--paper-dot);
  }

  .case__panel--after .dots i {
    background: var(--line-card);
  }

  .case__panel .dots i.on {
    background: var(--accent);
  }

  /* The top of the 14 to 16 range. */
  .case__panel .dots i.maybe {
    background: rgb(224 86 52 / 0.35);
  }

  /* The operator's words: one card across both columns, the mark beside the quote. */
  .case__quote {
    margin: 0;
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);
    column-gap: clamp(16px, 2.4vw, 32px);
    row-gap: 16px;
    padding: clamp(24px, 3.6vw, 48px);
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--card-line);
  }

  .case__mark {
    grid-row: span 2;
    font-size: 4.5rem;
    font-weight: 700;
    line-height: 0.8;
    color: var(--accent);
  }

  .case__quote blockquote {
    max-width: 60ch;
    margin: 0;
    font-size: var(--step-h4);
    font-weight: 500;
    line-height: 1.45;
    letter-spacing: -0.01em;
    text-wrap: pretty;
  }

  .case__quote figcaption {
    font-size: var(--step-small);
    color: var(--fg-3);
  }

  .case__quote figcaption b {
    font-weight: 600;
    color: var(--fg);
  }

  /* Phones: the mark above the words. */
  @media (max-width: 599px) {
    .case__quote {
      grid-template-columns: minmax(0, 1fr);
    }

    .case__mark {
      grid-row: auto;
      font-size: 3.5rem;
      line-height: 0.6;
    }
  }
</style>
