---
import { Image } from 'astro:assets';
import '../../styles/slack.css';
import tray from '../../assets/images/order-tray.jpg';
import mark from '../../assets/logos/aldente-mark.svg';
import Icon from '../ui/Icon.astro';
import ProductPill from '../ui/ProductPill.astro';
import SectionHeader from '../ui/SectionHeader.astro';

const bars = [30, 48, 70, 100, 86, 54, 40, 62];
// The dispute desk's recent claims, newest first (the same #4821 as the rest of the site).
const claims = [
  { order: '#4821', app: 'Uber Eats', amount: '$17.40', status: 'Reversed', tone: 'ok' },
  { order: '#4790', app: 'DoorDash', amount: '$45.84', status: 'Evidence sent', tone: 'wait' },
  { order: '#4766', app: 'Grubhub', amount: '$24.90', status: 'Reversed', tone: 'ok' },
];
const wave = [6, 12, 18, 9, 20, 14, 7, 16, 22, 11, 6, 13, 19, 10, 15, 8];
---

<section class="products tone-dark section" id="product" aria-labelledby="products-title">
  <div class="container products__inner">
    <SectionHeader
      id="products-title"
      label="Products"
      title="Four connected products"
      muted="that work as one."
      lead="Order, refund and camera records feed Aldo’s answers and Playbooks, so every product makes the others smarter."
    />
    <ul class="products__grid" role="list">
      <li>
        <a class="product" data-loop href="/aldo">
          <div class="product__art product__art--slack" aria-hidden="true">
            <div class="mini-window slack">
              <div class="mini-msg">
                <span class="mini-avatar" style="background:#2b6cb0">DM</span>
                <div class="mini-body">
                  <p class="slack-text"><b>District manager</b></p>
                  <span class="voice">
                    <span class="voice__play"><Icon name="mic" size={12} strokeWidth={2.25} /></span>
                    <span class="voice__wave">{wave.map((h, i) => <i style={`--h:${h}px;--d:${(i % 6) * 0.11}s`} />)}</span>
                    <span class="voice__time">0:04</span>
                  </span>
                  <p class="mini-transcript">“How many visitors yesterday?”</p>
                </div>
              </div>
              <div class="mini-msg">
                <span class="mini-avatar mini-avatar--aldo"><img src={mark.src} alt="" width="14" height="17" /></span>
                <div class="mini-body">
                  <p class="slack-text"><b>Aldo</b></p>
                  <p class="slack-text">3,499 visitors across 3 locations, up 4%. Busiest: 12:00–13:00 at Location 03.</p>
                  <p class="slack-muted">Source: Aldente Vision · 3 locations</p>
                </div>
              </div>
            </div>
          </div>
          <div class="product__copy">
            <ProductPill product="aldo" />
            <h3>Your AI Chief of Staff</h3>
            <p>Answers in Slack and runs routine work. Ask once: a Playbook repeats the check and posts the result.</p>
            <span class="product__link">Explore Aldo <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
          </div>
        </a>
      </li>
      <li>
        <a class="product" data-loop href="/order-verification">
          {/* The Verify app at the packing station: the camera view with its detections, the POS order, the fix. */}
          <div class="product__art station" aria-hidden="true">
            <div class="station__screen">
              <div class="station__cam">
                <Image src={tray} alt="" widths={[320, 560]} sizes="(min-width: 640px) 280px, 80vw" />
                <span class="station__box station__box--ok" style="left:2%;top:36%;width:55%;height:49%"></span>
                <span class="station__box station__box--alert" style="left:67%;top:38%;width:31%;height:48%"><i>1 of 2</i></span>
                <span class="station__scan"></span>
              </div>
              <div class="station__order">
                <p class="station__head"><b>#4821</b><span>Delivery</span></p>
                <ul role="list">
                  <li><span>Sandwich</span><b>1/1</b></li>
                  <li><span>Fries</span><b>1/1</b></li>
                  <li class="station__miss"><span>Drinks</span><b>1/2</b></li>
                </ul>
                <p class="station__action">Add 1 drink</p>
              </div>
            </div>
          </div>
          <div class="product__copy">
            <ProductPill product="verify" />
            <h3>Order verification</h3>
            <p>Checks every bag before pickup, with a photo and a clip for every order.</p>
            <span class="product__link">Explore Aldente Verify <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
          </div>
        </a>
      </li>
      <li>
        <a class="product" data-loop href="/order-verification#dispute">
          {/* The dispute desk, as on the deck: what came back this month and the latest claims with their status. */}
          <div class="product__art" aria-hidden="true">
            <div class="desk">
              <div class="desk__top">
                <span class="desk__brand"><img src={mark.src} alt="" width="9" height="11" />Delivery disputes</span>
                <span class="desk__kpi">Won back this month <b>$4,202</b></span>
              </div>
              <div class="desk__table">
                <p class="desk__row desk__row--head"><span>Order</span><span class="desk__app">App</span><span>Amount</span><span>Status</span></p>
                {
                  claims.map((c, i) => (
                    <p class:list={['desk__row', { 'desk__row--new': i === 0 }]}>
                      <b>{c.order}</b>
                      <span class="desk__app">{c.app}</span>
                      <span>{c.amount}</span>
                      <span class:list={['desk__status', `desk__status--${c.tone}`]}>{c.status}</span>
                    </p>
                  ))
                }
              </div>
            </div>
          </div>
          <div class="product__copy">
            <ProductPill product="dispute" />
            <h3>Refund disputes</h3>
            <p>Builds the evidence pack for every delivery-app refund claim: the packing clip, the item check and the handoff time.</p>
            <span class="product__link">Explore Aldente Dispute <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
          </div>
        </a>
      </li>
      <li>
        <a class="product" data-loop href="/analytics">
          <div class="product__art" aria-hidden="true">
            <div class="check__head"><b>Visitors by hour</b><span>Today</span></div>
            <div class="bars">
              {bars.map((h) => <i class:list={{ hot: h === 100 }} style={`--h:${h}%`} />)}
            </div>
            <div class="bars__axis"><span>10</span><span>12</span><span>14</span><span>16</span><span>18</span></div>
          </div>
          <div class="product__copy">
            <ProductPill product="vision" />
            <h3>Camera AI</h3>
            <p>Turns your cameras into traffic, queue, table and staff data, for every location, hour by hour.</p>
            <span class="product__link">Explore Aldente Vision <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
          </div>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .products__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* One column on phones, a 2 × 2 grid from 640px. */
  .products__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  @media (min-width: 640px) {
    .products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .product {
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--card-line);
    overflow: hidden;
    transition:
      transform 0.25s var(--ease-out),
      border-color 0.25s ease;
  }

  .product:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }

  .product__art {
    height: 272px;
    padding: var(--card-pad-m);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .product__copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--card-pad-m);
  }

  .product h3 {
    font-size: var(--step-h3);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .product__copy p {
    color: var(--ink-2);
  }

  .product__link {
    margin-top: auto;
    padding-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .product__link :global(svg) {
    transition: transform 0.2s var(--ease-out);
  }

  .product:hover .product__link :global(svg) {
    transform: translateX(3px);
  }

  /* Aldo card: a voice question and Aldo's answer in a Slack window, on the same dark ground and
     centred like the other cards' art. */
  .mini-window {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: var(--card-pad-s);
    border-radius: var(--radius-m);
    background: #ffffff;
  }

  .mini-msg {
    display: flex;
    gap: 8px;
  }

  .mini-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mini-avatar {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-s);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mini-avatar--aldo {
    background: #0b0b0b;
  }

  .product__art--slack .slack-text {
    font-size: 14px;
  }

  .mini-transcript {
    font-size: 13px;
    font-style: italic;
    color: #616061;
  }

  .voice {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 5px;
    border-radius: var(--radius-pill);
    background: #1d1c1d;
  }

  .voice__play {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .voice__wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 24px;
  }

  .voice__wave i {
    width: 3px;
    height: var(--h);
    border-radius: var(--radius-xs);
    background: var(--accent);
  }

  .voice__time {
    font-size: 11px;
    color: #b3b3b3;
    font-variant-numeric: tabular-nums;
  }

  /* Card heading inside an art panel (Aldente Vision's chart). */
  .check__head {
    display: flex;
    justify-content: space-between;
    font-size: var(--step-label);
    color: var(--ink-3);
  }

  .check__head b {
    color: var(--ink);
  }

  /* Verify: the packing-station screen. The camera keeps the photo's own shape, so the boxes stay on the items. */
  .station {
    padding-block: 18px;
  }

  .station__screen {
    display: flex;
    gap: 10px;
    height: 100%;
    padding: 8px;
    border-radius: var(--radius-m);
    background: #1a1a1a;
    border: 1px solid var(--line-card);
  }

  .station__cam {
    position: relative;
    flex: none;
    height: 100%;
    aspect-ratio: 962 / 716;
    border-radius: 10px;
    overflow: hidden;
  }

  .station__cam :global(img) {
    display: block;
    width: 100%;
    height: 100%;
  }

  .station__box {
    position: absolute;
    border: 3px solid;
    border-radius: 10px;
  }

  .station__box--ok {
    border-color: var(--ok);
  }

  .station__box--alert {
    border-color: var(--accent);
  }

  .station__box i {
    position: absolute;
    left: -3px;
    bottom: calc(100% + 4px);
    padding: 1px 6px;
    border-radius: 6px;
    background: var(--accent);
    color: var(--on-accent);
    font-size: 11px;
    font-style: normal;
    font-weight: 700;
    white-space: nowrap;
  }

  .station__scan {
    position: absolute;
    left: 0;
    right: 0;
    top: 0;
    height: 2px;
    background: var(--accent);
    box-shadow: 0 0 12px 2px var(--accent);
    opacity: 0;
  }

  .station__order {
    flex: 1;
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 6px;
    font-size: 13px;
  }

  .station__head {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    color: var(--ink-3);
    font-size: 12px;
  }

  .station__head b {
    color: var(--ink);
  }

  .station__order ul {
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .station__order li {
    display: flex;
    justify-content: space-between;
    gap: 6px;
    padding: 6px 8px;
    border-radius: 6px;
    background: var(--surface-2);
  }

  .station__order li b {
    color: var(--ok);
    font-variant-numeric: tabular-nums;
  }

  li.station__miss {
    background: var(--accent-soft);
  }

  li.station__miss b {
    color: var(--accent);
  }

  .station__action {
    margin-top: auto;
    padding: 7px 8px;
    border-radius: 8px;
    background: var(--accent);
    color: var(--on-accent);
    font-weight: 700;
    text-align: center;
  }

  /* Phones: the camera alone, with the fix on it. */
  @media (max-width: 479px) {
    .station__screen {
      justify-content: center;
    }

    .station__order {
      display: none;
    }
  }

  /* Dispute: the dispute desk's light dashboard (the decks' #fafaf8 ground and darkened green for AA). */
  .desk {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 14px;
    border-radius: var(--radius-m);
    background: #fafaf8;
    color: #141414;
    font-size: 13px;
  }

  .desk__top {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 12px;
  }

  .desk__brand {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    font-weight: 700;
  }

  .desk__brand img {
    width: 20px;
    height: 20px;
    padding: 4px 5px;
    border-radius: 5px;
    background: #0b0b0b;
  }

  .desk__kpi {
    padding: 4px 10px;
    border-radius: 8px;
    border: 1px solid #e4e4e0;
    background: #ffffff;
    color: #6b6b6b;
    font-size: 12px;
  }

  .desk__kpi b {
    margin-left: 4px;
    color: #147a43;
    font-size: 14px;
  }

  .desk__table {
    border: 1px solid #e4e4e0;
    border-radius: 10px;
    background: #ffffff;
    overflow: hidden;
  }

  .desk__row {
    display: grid;
    grid-template-columns: 1fr 1.1fr 0.9fr 1.3fr;
    align-items: center;
    gap: 8px;
    padding: 8px 12px;
    border-top: 1px solid #efefec;
    font-variant-numeric: tabular-nums;
  }

  .desk__row--head {
    border-top: 0;
    background: #f6f6f3;
    color: #6b6b6b;
    font-size: 12px;
  }

  .desk__row--new {
    background: #fff4ef;
  }

  .desk__status {
    justify-self: start;
    padding: 1px 8px;
    border-radius: var(--radius-pill);
    font-size: 12px;
    font-weight: 700;
    white-space: nowrap;
  }

  .desk__status--ok {
    background: #e6f5ec;
    color: #147a43;
  }

  .desk__status--wait {
    background: #fdf1dc;
    color: #8a5a0a;
  }

  @media (max-width: 479px) {
    .desk__row {
      grid-template-columns: 1fr 0.9fr 1.3fr;
    }

    .desk__app {
      display: none;
    }
  }

  /* Bars card */
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 150px;
  }

  .bars i {
    flex: 1;
    height: var(--h);
    border-radius: var(--radius-xs);
    background: var(--line);
  }

  .bars i.hot {
    background: var(--accent);
  }

  .bars__axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  /* Motion that shows the product working: Aldo hears a voice note; the station's camera scans the bag. */
  @media (prefers-reduced-motion: no-preference) {
    .voice__wave i {
      animation: voice 1.1s ease-in-out infinite;
      animation-delay: var(--d);
    }

    .station__scan {
      animation: station-scan 3.2s linear infinite;
    }
  }

  @keyframes station-scan {
    0% {
      top: 0;
      opacity: 0;
    }
    10%,
    90% {
      opacity: 0.6;
    }
    100% {
      top: 100%;
      opacity: 0;
    }
  }


  @keyframes voice {
    50% {
      transform: scaleY(0.35);
    }
  }




</style>
