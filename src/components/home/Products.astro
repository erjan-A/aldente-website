---
import '../../styles/slack.css';
import mark from '../../assets/logos/aldente-mark.svg';
import Icon from '../ui/Icon.astro';
import ProductPill from '../ui/ProductPill.astro';
import SectionHeader from '../ui/SectionHeader.astro';

const bars = [30, 48, 70, 100, 86, 54, 40, 62];
const wave = [6, 12, 18, 9, 20, 14, 7, 16, 22, 11, 6, 13, 19, 10, 15, 8];
---

<section class="products tone-dark section" id="product" aria-labelledby="products-title">
  <div class="container products__inner">
    <SectionHeader
      id="products-title"
      title="Three connected products"
      muted="that work as one."
      lead="Order and camera records feed Aldo’s answers and Playbooks, so every product makes the others smarter."
    />
    <ul class="products__grid" role="list">
      <li>
        <a class="product" data-loop href="/aldo">
          <div class="product__art product__art--slack" aria-hidden="true">
            <div class="mini-window slack">
              <div class="mini-msg">
                <span class="mini-avatar" style="background:#2b6cb0">DM</span>
                <div class="mini-body">
                  <p class="slack-text"><b>District manager</b></p>
                  <span class="voice">
                    <span class="voice__play"><Icon name="mic" size={12} strokeWidth={2.25} /></span>
                    <span class="voice__wave">{wave.map((h, i) => <i style={`--h:${h}px;--d:${(i % 6) * 0.11}s`} />)}</span>
                    <span class="voice__time">0:04</span>
                  </span>
                  <p class="mini-transcript">“How many guests did we have yesterday?”</p>
                </div>
              </div>
              <div class="mini-msg">
                <span class="mini-avatar mini-avatar--aldo"><img src={mark.src} alt="" width="14" height="17" /></span>
                <div class="mini-body">
                  <p class="slack-text"><b>Aldo</b> <span class="mini-app">APP</span></p>
                  <p class="slack-text">3,646 guests across 3 locations, 6% more than last Tuesday. Busiest: 12:00–13:00 at Location 03.</p>
                </div>
              </div>
            </div>
          </div>
          <div class="product__copy">
            <ProductPill product="aldo" />
            <h3>Your AI Chief of Staff</h3>
            <p>Ask by text or voice in Slack, and give Aldo the recurring work. It answers with numbers, clips and records.</p>
            <span class="product__link">Explore Aldo <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
          </div>
        </a>
      </li>
      <li>
        <a class="product" data-loop href="/order-verification">
          <div class="product__art" aria-hidden="true">
            <div class="check__head"><b>Order #4821</b><span>Location 01</span></div>
            <div class="check__row"><span class="tick tick--1"><Icon name="check" size={13} strokeWidth={3} /></span>Turkey sandwich</div>
            <div class="check__row"><span class="tick tick--2"><Icon name="check" size={13} strokeWidth={3} /></span>Fries</div>
            <div class="check__row">
              <span class="tick tick--miss"><Icon name="check" size={13} strokeWidth={3} /></span>Drinks
              <span class="check__flag check__flag--miss">1 of 2 in bag</span>
              <span class="check__flag check__flag--ok">Fixed before pickup</span>
            </div>
          </div>
          <div class="product__copy">
            <ProductPill product="verify" />
            <h3>Order verification</h3>
            <p>Catch packing errors before pickup, keep the evidence and win refund disputes automatically.</p>
            <span class="product__link">Explore Aldente Verify <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
          </div>
        </a>
      </li>
      <li>
        <a class="product" data-loop href="/analytics">
          <div class="product__art" aria-hidden="true">
            <div class="check__head"><b>Guests by hour</b><span>Today</span></div>
            <div class="bars">
              {bars.map((h) => <i class:list={{ hot: h === 100 }} style={`--h:${h}%`} />)}
            </div>
            <div class="bars__axis"><span>10</span><span>12</span><span>14</span><span>16</span><span>18</span></div>
          </div>
          <div class="product__copy">
            <ProductPill product="vision" />
            <h3>Camera AI</h3>
            <p>Computer vision and VLMs turn the cameras you already have into events, triggers and analytics for every location.</p>
            <span class="product__link">Explore Aldente Vision <Icon name="arrow-right" size={16} strokeWidth={2} /></span>
          </div>
        </a>
      </li>
    </ul>
  </div>
</section>

<style>
  .products__inner {
    display: flex;
    flex-direction: column;
    gap: 56px;
  }

  /* One column on phones, two on tablets with the third card across the row, three from 1024px. */
  .products__grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 16px;
  }

  @media (min-width: 640px) {
    .products__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .products__grid > li:last-child:nth-child(odd) {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .products__grid {
      grid-template-columns: repeat(3, minmax(0, 1fr));
    }

    .products__grid > li:last-child:nth-child(odd) {
      grid-column: auto;
    }
  }

  .product {
    height: 100%;
    display: flex;
    flex-direction: column;
    border-radius: var(--radius-l);
    background: var(--card);
    border: 1px solid var(--card-line);
    overflow: hidden;
    transition:
      transform 0.25s var(--ease-out),
      border-color 0.25s ease;
  }

  .product:hover {
    transform: translateY(-4px);
    border-color: var(--line-strong);
  }

  .product__art {
    height: 272px;
    padding: var(--card-pad-m);
    background: var(--bg);
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: 10px;
  }

  .product__copy {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--card-pad-m);
  }

  .product h3 {
    font-size: var(--step-h3);
    line-height: 1.2;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .product__copy p {
    color: var(--ink-2);
  }

  .product__link {
    margin-top: auto;
    padding-top: 8px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    font-weight: 600;
  }

  .product__link :global(svg) {
    transition: transform 0.2s var(--ease-out);
  }

  .product:hover .product__link :global(svg) {
    transform: translateX(3px);
  }

  /* Aldo card: a voice question and Aldo's answer in a Slack window, on the same dark ground and
     centred like the other two cards' art. */
  .mini-window {
    display: flex;
    flex-direction: column;
    gap: 14px;
    padding: var(--card-pad-s);
    border-radius: var(--radius-m);
    background: #ffffff;
  }

  .mini-msg {
    display: flex;
    gap: 8px;
  }

  .mini-body {
    min-width: 0;
    display: flex;
    flex-direction: column;
    gap: 4px;
  }

  .mini-avatar {
    flex: none;
    width: 30px;
    height: 30px;
    border-radius: var(--radius-s);
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .mini-avatar--aldo {
    background: #0b0b0b;
  }

  .mini-app {
    padding: 1px 3px;
    border-radius: var(--radius-xs);
    color: rgb(29 28 29 / 0.8);
    background: rgb(29 28 29 / 0.13);
    font-size: 11px;
    font-weight: 700;
  }

  .product__art--slack .slack-text {
    font-size: 14px;
  }

  .mini-transcript {
    font-size: 13px;
    font-style: italic;
    color: #616061;
  }

  .voice {
    align-self: flex-start;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 5px 12px 5px 5px;
    border-radius: var(--radius-pill);
    background: #1d1c1d;
  }

  .voice__play {
    width: 24px;
    height: 24px;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .voice__wave {
    display: flex;
    align-items: center;
    gap: 2px;
    height: 24px;
  }

  .voice__wave i {
    width: 3px;
    height: var(--h);
    border-radius: var(--radius-xs);
    background: var(--accent);
  }

  .voice__time {
    font-size: 11px;
    color: #b3b3b3;
    font-variant-numeric: tabular-nums;
  }

  /* Order card */
  .check__head {
    display: flex;
    justify-content: space-between;
    font-size: var(--step-label);
    color: var(--ink-3);
  }

  .check__head b {
    color: var(--ink);
  }

  .check__row {
    position: relative;
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 10px 12px;
    border-radius: var(--radius-s);
    background: var(--surface);
    font-size: var(--step-small);
  }

  .tick {
    width: 22px;
    height: 22px;
    border-radius: var(--radius-xs);
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--ok);
    color: var(--on-accent);
  }

  .check__flag {
    position: absolute;
    right: 12px;
    font-size: 0.75rem;
    font-weight: 600;
  }

  .check__flag--miss {
    color: var(--accent);
    opacity: 0;
  }

  .check__flag--ok {
    color: var(--ok);
  }

  /* Bars card */
  .bars {
    display: flex;
    align-items: flex-end;
    gap: 8px;
    height: 150px;
  }

  .bars i {
    flex: 1;
    height: var(--h);
    border-radius: var(--radius-xs);
    background: var(--line);
  }

  .bars i.hot {
    background: var(--accent);
  }

  .bars__axis {
    display: flex;
    justify-content: space-between;
    font-size: 0.75rem;
    color: var(--ink-3);
  }

  /* Motion that shows the product working: Aldo hears a voice note; a bag gets checked. */
  @media (prefers-reduced-motion: no-preference) {
    .voice__wave i {
      animation: voice 1.1s ease-in-out infinite;
      animation-delay: var(--d);
    }

    .tick--1 {
      animation: tick 5s ease infinite;
    }

    .tick--2 {
      animation: tick 5s ease 0.6s infinite;
    }

    .tick--miss {
      animation: miss 5s ease infinite;
    }

    .check__flag--miss {
      animation: flag-miss 5s ease infinite;
    }

    .check__flag--ok {
      animation: flag-ok 5s ease infinite;
    }
  }

  @keyframes voice {
    50% {
      transform: scaleY(0.35);
    }
  }

  @keyframes tick {
    0%,
    20% {
      background: var(--surface-2);
      color: transparent;
    }
    28%,
    100% {
      background: var(--ok);
      color: var(--on-accent);
    }
  }

  @keyframes miss {
    0%,
    45% {
      background: var(--accent);
      color: transparent;
    }
    55%,
    100% {
      background: var(--ok);
      color: var(--on-accent);
    }
  }

  @keyframes flag-miss {
    0%,
    45% {
      opacity: 1;
    }
    55%,
    100% {
      opacity: 0;
    }
  }

  @keyframes flag-ok {
    0%,
    45% {
      opacity: 0;
    }
    55%,
    100% {
      opacity: 1;
    }
  }
</style>
