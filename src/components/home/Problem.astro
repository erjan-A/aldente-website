---
import SectionHeader from '../ui/SectionHeader.astro';

// The delivery-refund problem (rewritten 2026-10-13): what goes wrong, what it costs, the hours it eats.
const facts = [
  { value: '7–8%', unit: '', text: 'of delivery orders left one chain location wrong.' },
  { value: '$170', unit: 'a day', text: 'even 10 wrong orders at a $17 check, before the gift card.' },
  { value: '1–2 hours', unit: 'a day', text: 'go to searching footage, collecting evidence and disputing refunds.' },
];
---

<section class="problem tone-orange section" aria-labelledby="problem-title">
  <div class="container problem__inner">
    <SectionHeader id="problem-title" label="The problem" layout="stack" title="Delivery apps refund the guest first." muted="You have to prove it wasn’t you." />
    <dl class="problem__facts">
      {
        facts.map((fact) => (
          <div>
            <dt>
              {fact.value}
              {fact.unit && <span> {fact.unit}</span>}
            </dt>
            <dd>{fact.text}</dd>
          </div>
        ))
      }
    </dl>
    <p class="problem__turn">Aldente puts every bag on record at the packing station, so a claim is settled with evidence, not an argument.</p>
  </div>
</section>

<style>
  .problem__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  .problem__facts {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
    margin: 0;
    border-top: 2px solid var(--card-line);
  }

  .problem__facts div {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 28px 32px 0 0;
  }

  /* The figures sit on the heading's step, never above it. */
  .problem__facts dt {
    font-size: var(--step-h2);
    font-weight: 700;
    letter-spacing: -0.04em;
    line-height: 1;
  }

  .problem__facts dt span {
    font-size: var(--step-h4);
    letter-spacing: -0.01em;
  }

  .problem__facts dd {
    margin: 0;
    max-width: 30ch;
    font-size: 1.125rem;
    font-weight: 500;
    line-height: 1.5;
  }

  .problem__turn {
    max-width: 34ch;
    font-size: var(--step-h3);
    font-weight: 600;
    line-height: 1.35;
    letter-spacing: -0.01em;
  }
</style>
