---
import type { ProductId } from '../../data/products';
import '../../styles/slack.css';
import { PLAYBOOKS } from '../../data/playbooks';
import { LINKS } from '../../data/site';
import type { Asker } from '../../data/solutions';
import { filterByTeam, graphSteps, teamsOf, type Playbook, type TeamFilter } from '../../lib/playbooks';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  /** Limit to one team (solution pages). */
  team?: TeamFilter;
  /** Playbook ids to leave out, e.g. the one a solution page already shows in its hero. */
  exclude?: string[];
  /** Who asks Aldo in the request bubble. Defaults to a district manager. */
  asker?: Asker;
  /** The heading block. Override the text on pages where the home wording doesn't fit. */
  title?: string;
  muted?: string;
  lead?: string;
  /** The product pill over the heading; null on Aldo's own page, where the hero already names it. */
  product?: ProductId | null;
  /** The "comes with Aldente Verify or Aldente Vision" band; off where the closing CTA band follows right after. */
  band?: boolean;
}

const {
  product = 'aldo',
  team = 'All',
  exclude = [],
  asker = { role: 'District manager', initials: 'DM', color: '#2b6cb0' },
  title = 'Ask once.',
  muted = 'Aldo handles it every shift.',
  lead = 'A Playbook is a saved task: what to check, when to run, and where to send the result. Say it in a sentence, or say it out loud. Aldo confirms the details and starts working.',
  band = true,
} = Astro.props;
const playbooks: Playbook[] = filterByTeam(PLAYBOOKS, team).filter((p) => !exclude.includes(p.id));
// The links to the solution pages belong on the overview (home, /aldo), not on a solution page itself.
const overview = team === 'All';
const teams = team === 'All' ? teamsOf(PLAYBOOKS) : [];
const first = playbooks[0]!;
const steps = graphSteps(first);
---

<section class="playbooks tone-paper section" id="playbooks" aria-labelledby="playbooks-title">
  <div class="container playbooks__inner">
    <SectionHeader product={product ?? undefined} id="playbooks-title" title={title} muted={muted} lead={lead} />

    <playbook-explorer class="pb">
      {
        teams.length > 0 && (
          <div class="pb__filters" role="group" aria-label="Filter Playbooks by team">
            {teams.map((t) => (
              <button type="button" data-filter={t} aria-pressed={t === 'All' ? 'true' : 'false'}>
                {t}
              </button>
            ))}
          </div>
        )
      }

      <div class="pb__layout">
        <ul class:list={['pb__list', { 'pb__list--short': playbooks.length <= 3 }]} role="list" aria-label="Playbook examples">
          {
            playbooks.map((p, i) => (
              <li data-team={p.team}>
                <button type="button" class="pb__item" data-playbook={JSON.stringify(p)} aria-pressed={i === 0 ? 'true' : 'false'}>
                  <span class="pb__item-head">
                    <span class="pb__team">{p.team}</span>
                    <span class="pb__title">{p.title}</span>
                  </span>
                  <span class="pb__say">“{p.say}”</span>
                </button>
              </li>
            ))
          }
        </ul>

        {/* data-loop: the looping flow pauses as soon as the graph is off screen, not only the whole (tall) section. */}
        <div class="pb__graph" data-graph data-run data-loop>
          <div class="pb__request slack">
            <span class="pb__avatar" style={`background:${asker.color}`} aria-hidden="true">{asker.initials}</span>
            <div>
              <p class="pb__request-meta"><b>{asker.role}</b> to Aldo</p>
              <p class="slack-text" data-graph-say>{first.say}</p>
            </div>
          </div>
          <div class="pb__card">
            <div class="pb__card-head">
              <span class="pb__card-title" data-graph-title aria-live="polite">{first.title}</span>
              <span class="pb__card-status"><Icon name="check" size={12} strokeWidth={3} /> Confirmed</span>
            </div>
            <ol class="pb__steps" role="list">
              {
                steps.map((step) => (
                  <li class="pb__node">
                    <span class="pb__node-label">{step.label}</span>
                    <span class="pb__node-value" data-graph-step={step.kind}>
                      {step.value}
                    </span>
                  </li>
                ))
              }
            </ol>
            <div class="pb__result">
              <span class="pb__ok" aria-hidden="true"><Icon name="check" size={13} strokeWidth={3} /></span>
              <span data-graph-result>{first.result}</span>
            </div>
          </div>
        </div>
      </div>
    </playbook-explorer>

    {
      band && (
        <div class="playbooks__cta tone-dark">
          <p>Aldo and its Playbooks come with Aldente Verify or Aldente Vision.</p>
          <Button href={LINKS.pricing} variant="secondary">
            Compare plans
          </Button>
        </div>
      )
    }
    {
      overview && (
        <nav class="playbooks__teams" aria-label="Playbooks by team">
          <span>Playbooks for</span>
          <a href="/solutions/operations">Operations</a>
          <a href="/solutions/hr">HR</a>
          <a href="/solutions/delivery">Delivery</a>
        </nav>
      )
    }
  </div>
</section>

<script>
  import '../../scripts/playbook-explorer';
</script>

<style>
  .playbooks__inner {
    display: flex;
    flex-direction: column;
    gap: 48px;
  }

  .pb {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .pb__filters {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .pb__filters button {
    min-height: 44px;
    padding: 0 18px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--card-line);
    background: transparent;
    font-weight: 600;
    cursor: pointer;
    transition:
      background-color 0.2s ease,
      color 0.2s ease,
      border-color 0.2s ease;
  }

  .pb__filters button:hover {
    border-color: var(--paper-ink);
  }

  .pb__filters button[aria-pressed='true'] {
    background: var(--paper-ink);
    border-color: var(--paper-ink);
    color: var(--ink);
  }

  .pb__layout {
    display: flex;
    flex-wrap: wrap;
    gap: 24px;
    align-items: flex-start;
  }

  .pb__list {
    flex: 1 1 380px;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  /* A short list (solution pages) runs in one column beside the graph, so no card sits alone beside a gap. */
  .pb__list--short {
    grid-template-columns: minmax(0, 1fr);
  }

  .pb__item {
    width: 100%;
    height: 100%;
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: var(--card-pad-m);
    border-radius: var(--radius-l);
    border: 1px solid var(--card-line);
    background: var(--card);
    text-align: left;
    cursor: pointer;
    transition:
      transform 0.2s var(--ease-out),
      border-color 0.2s ease;
  }

  .pb__item:hover {
    transform: translateY(-3px);
    border-color: var(--paper-ink);
  }

  .pb__item[aria-pressed='true'] {
    border-color: var(--accent);
    box-shadow: inset 0 0 0 1px var(--accent);
  }

  .pb__item-head {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .pb__team {
    align-self: flex-start;
    padding: 5px 10px;
    border-radius: var(--radius-pill);
    background: var(--tag-bg);
    color: var(--tag-fg);
    font-size: var(--step-label);
    font-weight: 600;
  }

  .pb__title {
    font-size: var(--step-h4);
    font-weight: 600;
    letter-spacing: -0.015em;
  }

  .pb__say {
    font-size: var(--step-small);
    color: var(--paper-ink-2);
  }

  .pb__graph {
    flex: 1 1 380px;
    position: sticky;
    top: calc(var(--header-h) + 24px);
    display: flex;
    flex-direction: column;
    gap: 12px;
  }

  .pb__request {
    padding: var(--card-pad-s);
    border-radius: var(--radius-l);
    background: #ffffff;
    border: 1px solid var(--card-line);
    display: flex;
    gap: 10px;
  }

  .pb__avatar {
    flex: none;
    width: 32px;
    height: 32px;
    border-radius: var(--radius-s);
    background: #2b6cb0;
    color: #ffffff;
    font-size: 11px;
    font-weight: 700;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pb__request-meta {
    margin-bottom: 2px;
    font-size: var(--step-label);
    color: #616061;
  }

  .pb__request-meta b {
    color: #1d1c1d;
  }

  .pb__card {
    padding: var(--card-pad-m);
    border-radius: var(--radius-l);
    background: var(--bg);
    color: var(--ink);
    display: flex;
    flex-direction: column;
    gap: 20px;
  }

  .pb__card-head {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 8px 16px;
  }

  .pb__card-status {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    padding: 4px 10px;
    border-radius: var(--radius-pill);
    background: var(--ok-soft);
    color: var(--ok);
    font-size: var(--step-label);
    font-weight: 600;
  }

  .pb__card-title {
    font-size: var(--step-h3);
    font-weight: 600;
    letter-spacing: -0.02em;
  }

  .pb__steps {
    display: flex;
    flex-direction: column;
  }

  .pb__node {
    position: relative;
    display: grid;
    grid-template-columns: 76px 1fr;
    align-items: center;
    gap: 12px;
    padding: 12px 14px;
    border-radius: var(--radius-m);
    border: 1px solid var(--line-card);
    background: var(--surface);
  }

  .pb__node + .pb__node {
    margin-top: 18px;
  }

  .pb__node + .pb__node::before {
    content: '';
    position: absolute;
    left: 32px;
    top: -19px;
    width: 2px;
    height: 18px;
    background: var(--line-strong);
    transform-origin: top;
  }

  .pb__node-label {
    font-size: var(--step-label);
    font-weight: 600;
    color: var(--ink-2);
  }

  .pb__node-value {
    font-weight: 500;
  }

  .pb__result {
    display: flex;
    gap: 10px;
    align-items: flex-start;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    color: var(--ink-2);
  }

  .pb__ok {
    flex: none;
    width: 22px;
    height: 22px;
    border-radius: 50%;
    background: var(--ok);
    color: var(--on-accent);
    font-size: 0.75rem;
    font-weight: 800;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  /* The flow lights step by step, the result checks off, then it fades and runs again. Picking a Playbook restarts it. */
  .pb__node + .pb__node::after {
    content: '';
    position: absolute;
    left: 32px;
    top: -19px;
    width: 2px;
    height: 18px;
    background: var(--accent);
    transform-origin: top;
    opacity: 0;
  }

  @media (prefers-reduced-motion: no-preference) {
    .pb__graph[data-run] .pb__node {
      animation: node-loop 6s var(--ease-out) infinite both;
    }

    .pb__graph[data-run] .pb__node + .pb__node::after {
      animation: wire-loop 6s linear infinite both;
    }

    .pb__graph[data-run] .pb__node:nth-child(2) {
      animation-delay: 0.45s;
    }

    .pb__graph[data-run] .pb__node:nth-child(3) {
      animation-delay: 0.9s;
    }

    .pb__graph[data-run] .pb__node:nth-child(4) {
      animation-delay: 1.35s;
    }

    .pb__graph[data-run] .pb__node:nth-child(2)::after {
      animation-delay: 0.25s;
    }

    .pb__graph[data-run] .pb__node:nth-child(3)::after {
      animation-delay: 0.7s;
    }

    .pb__graph[data-run] .pb__node:nth-child(4)::after {
      animation-delay: 1.15s;
    }

    .pb__graph[data-run] .pb__ok {
      animation: ok-loop 6s var(--ease-out) infinite both;
    }
  }

  @keyframes node-loop {
    0%,
    100% {
      border-color: var(--line-card);
      background: var(--surface);
    }
    5% {
      border-color: var(--accent);
      background: rgb(224 86 52 / 0.2);
    }
    12%,
    62% {
      border-color: var(--accent);
      background: rgb(224 86 52 / 0.08);
    }
    74% {
      border-color: var(--line-card);
      background: var(--surface);
    }
  }

  @keyframes wire-loop {
    0% {
      transform: scaleY(0);
      opacity: 1;
    }
    5%,
    62% {
      transform: scaleY(1);
      opacity: 1;
    }
    74%,
    100% {
      transform: scaleY(1);
      opacity: 0;
    }
  }

  @keyframes ok-loop {
    0%,
    30%,
    44%,
    100% {
      transform: scale(1);
      box-shadow: 0 0 0 0 rgb(79 191 133 / 0);
    }
    36% {
      transform: scale(1.25);
      box-shadow: 0 0 0 6px rgb(79 191 133 / 0.25);
    }
  }

  /* A dark band on the paper section: .tone-dark gives it the dark ground and ink roles. */
  .playbooks__cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 20px 20px 28px;
    border-radius: var(--radius-l);
  }

  .playbooks__cta p {
    font-size: var(--step-h4);
    font-weight: 600;
    line-height: 1.3;
    letter-spacing: -0.01em;
    text-wrap: balance;
  }

  .playbooks__teams {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
    font-size: var(--step-small);
    color: var(--fg-2);
  }

  .playbooks__teams a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding: 0 16px;
    border-radius: var(--radius-pill);
    border: 1.5px solid var(--card-line);
    color: var(--fg);
    font-weight: 600;
    transition: border-color 0.2s ease;
  }

  .playbooks__teams a:hover {
    border-color: var(--fg);
    color: var(--fg);
  }

  /* Phones: the graph comes first and the Playbooks scroll sideways beneath it, so a tap visibly changes it. */
  @media (max-width: 860px) {
    .pb__layout {
      flex-direction: column;
    }

    /* The team filters scroll in one row, like the cards they filter. */
    .pb__filters {
      flex-wrap: nowrap;
      overflow-x: auto;
      margin-inline: calc(-1 * var(--gutter));
      padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .pb__filters button {
      flex: none;
    }

    .pb__graph {
      position: static;
      order: -1;
      flex: none;
      width: 100%;
    }

    .pb__list {
      flex: none;
      width: calc(100% + 2 * var(--gutter));
      margin-inline: calc(-1 * var(--gutter));
      padding: 4px var(--gutter);
      display: flex;
      gap: 10px;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      scroll-padding-inline: var(--gutter);
      scrollbar-width: none;
    }

    .pb__list li {
      flex: 0 0 min(78%, 300px);
      scroll-snap-align: start;
    }

    .pb__list li[hidden] {
      display: none;
    }
  }

  /* Phones: the same compact rows as the Playbook card in the solution heroes. */
  @media (max-width: 480px) {
    .pb__node {
      grid-template-columns: 56px minmax(0, 1fr);
      gap: 8px;
      padding: 10px 12px;
      font-size: var(--step-small);
    }

    .pb__node + .pb__node::before,
    .pb__node + .pb__node::after {
      left: 26px;
    }
  }

  /* The "Playbooks for" label takes its own line, so the team links sit together on the next. */
  @media (max-width: 720px) {
    .playbooks__teams > span {
      flex-basis: 100%;
    }
  }
</style>
