---
import { PRODUCT_IDS, type ProductId } from '../../data/products';
import { LINKS } from '../../data/site';
import Button from '../ui/Button.astro';
import Icon from '../ui/Icon.astro';
import ProductPill from '../ui/ProductPill.astro';
import HeroMedia from './HeroMedia.astro';

/**
 * The home hero: the claim, two compact actions on one row (book, or watch the explainer first), then the
 * product panel running past the first screen.
 * The ground is orange, so the booking button is the dark one. Behind it all, <hero-backdrop> draws the
 * "Ember" glow.
 */

// One line per product, in the order of the clips below.
const promise: Partial<Record<ProductId, string>> = {
  tab: 'Ring up orders while staff build them.',
  verify: 'Check every order before pickup.',
  dispute: 'Answer every refund claim with proof.',
};
const lines = PRODUCT_IDS.flatMap((id) => promise[id] ?? []);
---

<section class="hero tone-orange" aria-labelledby="hero-title">
  <hero-backdrop aria-hidden="true"></hero-backdrop>
  <div class="container hero__inner">
    <div class="hero__copy">
      <ProductPill label="For restaurant chains" icon="utensils" />
      <h1 id="hero-title" class="hero__title"><span>Vision AI</span> for every order.</h1>
      <ul class="hero__lead" role="list">
        {
          lines.map((line) => <li>{line}</li>)
        }
      </ul>
      <div class="hero__actions">
        <Button href={LINKS.demo} variant="dark" size="sm" arrow><span>Book a <span class="hero__live">live </span>demo</span></Button>
        <Button href="/media/watch.mp4" variant="secondary" size="sm" data-watch>
          <Icon name="play" size={16} />
          Watch it work
        </Button>
      </div>
    </div>
    <HeroMedia />
  </div>
</section>

<script>
  import '../../scripts/hero-backdrop';
</script>

<style>
  /* Air first: the headline stands alone, then the product at work, which still starts on the first screen. */
  /* Its own stacking context: the backdrop (z-index -1) sits over the section's ground and under its content. */
  .hero {
    position: relative;
    isolation: isolate;
    padding-block: clamp(56px, 7vw, 104px) var(--section-y);
  }

  .hero__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(56px, 6vw, 88px);
  }

  .hero__copy {
    max-width: 1120px;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(24px, 2.2vw, 32px);
    text-align: center;
  }

  /* The page-title step of the type scale: one line on desktop, two balanced lines on phones, and the product
     panel starts inside the first screen. */
  .hero__title {
    font-size: var(--step-h1);
    line-height: 1;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }

  /* The hero stands on the same burning orange as the other orange sections. Its glow moves over that ground,
     and the copy has its own deeper ground over the glow (hero-backdrop.css), so white text keeps its
     contrast. Checked with tools/contrast.mjs. */

  /* Who the page is for: a pill, centred like the rest and a step closer to the headline it belongs to than
     the headline is to the lines under it. (On orange the pill is a dark chip by itself.) */
  .hero__copy :global(.pill) {
    align-self: center;
    margin-bottom: -8px;
  }

  /* Phones: the headline breaks after the category, so each tone has its own line. */
  @media (max-width: 479px) {
    .hero__title span {
      display: block;
    }
  }

  /* The one emphasis in the headline: the category stays full white and the rest steps back. */
  .hero__title {
    color: var(--fg-3);
  }

  .hero__title span {
    color: var(--fg);
  }

  /* One line per product, centred under the headline like the rest of the copy. */
  .hero__lead {
    display: grid;
    gap: 4px;
    font-size: var(--step-lead);
    line-height: 1.4;
    font-weight: 500;
    color: var(--fg);
  }

  /* A line that has to wrap on a narrow phone breaks into two even halves, never one stray word. */
  .hero__lead li {
    text-wrap: balance;
  }

  /* Phones: a step smaller, so each product keeps one line. */
  @media (max-width: 479px) {
    .hero__lead {
      font-size: var(--step-body);
    }
  }

  /* Two compact buttons on one row at every width; a step larger from tablets up. */
  .hero__actions {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-top: 8px;
  }

  @media (min-width: 720px) {
    .hero__actions :global(.btn) {
      min-height: 48px;
      padding: 0 24px;
      font-size: var(--step-ui);
    }
  }

  /* 360px phones: a tighter row without the arrow, so both buttons stay inside the gutters side by side. */
  @media (max-width: 379px) {
    .hero__actions {
      gap: 8px;
    }

    .hero__actions :global(.btn) {
      padding: 0 16px;
    }

    .hero__actions :global(.btn__arrow) {
      display: none;
    }
  }

  /* The narrowest phones: tighter still, and the button says "Book a demo". */
  @media (max-width: 359px) {
    .hero__actions :global(.btn) {
      padding: 0 12px;
    }

    .hero__live {
      display: none;
    }
  }

  .hero :global(.hm) {
    max-width: 1080px;
  }
</style>
