---
import { LINKS } from '../../data/site';
import Button from '../ui/Button.astro';
import Eyebrow from '../ui/Eyebrow.astro';
import HeroCards from './HeroCards.astro';

// "See Aldente in action" scrolls to the order story on this page (Verify + Dispute, id="verification"): one order, in action.
const seeAldente = '#verification';
---

<section class="hero tone-dark" aria-labelledby="hero-title">
  <div class="container">
    <div class="hero__stage">
      <HeroCards />
      <div class="hero__copy">
        <div class="hero__heading">
          <Eyebrow text="For restaurant chains and franchise operators" class="hero__eyebrow" />
          <h1 id="hero-title" class="hero__title">Your AI Chief of Staff <span>with eyes.</span></h1>
        </div>
        <p class="hero__lead">
          Aldente AI sees every location through your cameras, catches wrong orders before pickup, wins back refunds with evidence,
          and hands routine work to your AI employee in Slack.
        </p>
        <div class="hero__actions">
          <Button href={LINKS.demo} size="lg" arrow>Book a demo</Button>
          <Button href={seeAldente} variant="secondary" size="lg">See Aldente in action</Button>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    padding-block: clamp(72px, 9vw, 136px) clamp(56px, 6.5vw, 96px);
    overflow-x: clip;
  }

  /* Below 1240px the card deck sits above the headline and supplies the top space. */
  @media (max-width: 1239px) {
    .hero {
      padding-top: clamp(24px, 5vw, 56px);
    }
  }

  .hero__stage {
    position: relative;
  }

  .hero__copy {
    position: relative;
    z-index: 1;
    max-width: 780px;
    margin-inline: auto;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 28px;
    text-align: center;
  }

  /* The audience line sits tight on the headline it qualifies. */
  .hero__heading {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: clamp(16px, 1.2vw + 8px, 24px);
  }

  /* Centred like the headline: the dot runs inline, so a narrow phone wraps the line into two centred rows. */
  .hero__copy :global(.hero__eyebrow) {
    display: block;
    text-align: center;
  }

  .hero__copy :global(.hero__eyebrow)::before {
    display: inline-block;
    margin: 0 10px 0 0;
    vertical-align: middle;
    translate: 0 -1px;
  }

  .hero__title {
    font-size: var(--step-display);
    line-height: 0.95;
    letter-spacing: -0.04em;
    font-weight: 700;
    text-wrap: balance;
  }

  .hero__title span {
    color: var(--accent);
  }

  .hero__lead {
    max-width: 36ch;
    font-size: var(--step-lead);
    line-height: 1.5;
    color: var(--ink-2);
  }

  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
  }

  /* Phones: stacked buttons share one width. */
  @media (max-width: 479px) {
    .hero__actions > :global(.btn) {
      flex: 1 1 100%;
    }
  }
</style>
