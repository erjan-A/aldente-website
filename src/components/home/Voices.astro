---
import { Image } from 'astro:assets';
import { TEAM_LOGOS } from '../../data/logos';
import { retina } from '../../lib/images';
import Card from '../ui/Card.astro';
import SectionHeader from '../ui/SectionHeader.astro';

interface Props {
  /** Add the team line and logos (the company page). */
  team?: boolean;
  /** The section's ground: paper on the company page (the default), or dark. */
  tone?: 'dark' | 'paper';
}

const { team = false, tone = 'paper' } = Astro.props;

// Customers in the chain formats Aldente sells to, one per product: Aldo, Aldente Dispute, Aldente Verify.
const feature = {
  quote: 'I ask Aldo in Slack and get the clip from any of our restaurants in seconds. Our district managers stopped digging through footage.',
  role: 'Director of Operations',
  company: 'Multi-brand restaurant group',
};
const quotes = [
  {
    quote: 'We used to eat most refund claims, because fighting one took twenty minutes. Now the evidence pack is ready before anyone asks.',
    role: 'Head of Off-Premise',
    company: 'QSR chain',
  },
  {
    quote: 'Every wrong bowl cost us the refund and a gift card. Aldente catches it at the counter now, before the courier leaves.',
    role: 'VP of Operations',
    company: 'Fast-casual bowl chain',
  },
];
---

<section class:list={['voices section', `tone-${tone}`]} aria-labelledby="voices-title">
  <div class="container voices__inner">
    <SectionHeader id="voices-title" label="From our customers" layout="stack" title="Built with the people" muted="who run restaurants." />
    <div class="voices__quotes">
      <Card as="figure" class="quote quote--feature">
        <span class="quote__mark" aria-hidden="true">“</span>
        <blockquote>{feature.quote}</blockquote>
        <figcaption><b>{feature.role}</b><span>{feature.company}</span></figcaption>
      </Card>
      <div class="voices__side">
        {
          quotes.map((q) => (
            <Card as="figure" class="quote">
              <blockquote>“{q.quote}”</blockquote>
              <figcaption>
                <b>{q.role}</b> · {q.company}
              </figcaption>
            </Card>
          ))
        }
      </div>
    </div>
    {
      team && (
        <div class="team" id="team">
          <p class="team__line">
            <b>Restaurant operators and engineers from the best in both.</b>{' '}
            <span>Our team has run operations at P.F. Chang’s and KFC and built technology at Apple, LinkedIn and NVIDIA.</span>
          </p>
          <ul class="team__logos" role="list">
            {TEAM_LOGOS.map((logo) => (
              <li>
                <Image src={logo.src} alt={logo.name} height={logo.height} densities={retina(logo.src)} class={logo.treatment && `logo--${logo.treatment}`} style={`height:${logo.height}px`} />
              </li>
            ))}
          </ul>
        </div>
      )
    }
  </div>
</section>

<style>
  .voices__inner {
    display: flex;
    flex-direction: column;
    gap: var(--section-gap);
  }

  /* Three quotes in one row from 1024px (the featured one wider), so every card's attribution sits on one
     baseline and no card stretches into empty space. Two columns on tablets, one on phones. */
  .voices__quotes {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 12px;
  }

  @media (min-width: 720px) {
    .voices__quotes {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .voices .quote--feature {
      grid-column: 1 / -1;
    }
  }

  @media (min-width: 1024px) {
    .voices__quotes {
      grid-template-columns: minmax(0, 1.4fr) repeat(2, minmax(0, 1fr));
    }

    .voices .quote--feature {
      grid-column: auto;
    }
  }

  /* A Card (figure): the words at the top, who said them at the bottom. */
  /* Two classes, so these win over the Card's own rules whatever order the stylesheets load in. */
  .voices .quote {
    --card-gap: 20px;
    margin: 0;
    justify-content: space-between;
  }

  .quote blockquote {
    margin: 0;
    font-size: var(--step-h4);
    line-height: 1.45;
    font-weight: 500;
  }

  .quote figcaption {
    font-size: var(--step-small);
    color: var(--fg-3);
  }

  .quote figcaption b {
    color: var(--fg);
  }

  .voices .quote--feature {
    justify-content: flex-start;
    gap: 16px;
    padding: var(--card-pad-l);
    background: var(--bg);
    border-color: var(--bg);
    color: var(--ink);
  }

  .quote--feature blockquote {
    font-size: var(--step-h3);
    line-height: 1.3;
    letter-spacing: -0.02em;
    font-weight: 600;
  }

  .quote--feature figcaption {
    display: flex;
    flex-direction: column;
    gap: 2px;
    margin-top: auto;
    padding-top: 16px;
    font-size: var(--step-small);
    color: var(--ink-3);
  }

  .quote--feature figcaption b {
    color: var(--ink);
  }

  /* On the dark ground the featured quote turns paper, so it still stands apart from the cards beside it. */
  .tone-dark .quote--feature {
    background: var(--paper-card);
    border-color: var(--paper-card);
    color: var(--paper-ink);
  }

  .tone-dark .quote--feature figcaption {
    color: var(--paper-ink-3);
  }

  .tone-dark .quote--feature figcaption b {
    color: var(--paper-ink);
  }

  .quote--feature .quote__mark {
    margin-bottom: -12px;
  }

  .quote__mark {
    font-size: var(--step-h1);
    line-height: 0.6;
    font-weight: 700;
    color: var(--accent);
  }

  .voices__side {
    display: contents;
  }

  .team {
    display: flex;
    flex-direction: column;
    gap: 24px;
    padding-top: 40px;
    border-top: 1px solid var(--card-line);
  }

  .team__line {
    max-width: 56ch;
    font-size: var(--step-body);
  }

  .team__line span {
    color: var(--fg-2);
  }

  .team__logos {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 28px 48px;
  }

  .team__logos img {
    width: auto;
    opacity: 0.8;
  }

  .logo--silhouette {
    filter: brightness(0);
  }

  .logo--mono {
    filter: grayscale(1);
  }

  @media (max-width: 600px) {
    .team__logos {
      display: grid;
      grid-template-columns: repeat(3, auto);
      justify-content: space-between;
      gap: 24px 16px;
    }
  }
</style>
