---
import { LINKS } from '../../data/site';
import Button from '../ui/Button.astro';

interface Props {
  title?: string;
  text?: string;
  /** The demo page's ?plan=, so the booking page and the funnel know which product page the visitor came from. */
  plan?: string;
}

const {
  title = 'See it on your orders.',
  text = 'A 30-minute demo with our team. We show the checks on orders like yours and estimate the result for your locations.',
  plan,
} = Astro.props;
const demoHref = plan ? `${LINKS.demo}?plan=${plan}` : LINKS.demo;
// "30-minute" never breaks at its hyphen.
const textParts = text.split(/(\d+-minute)/);
---

<section class="cta tone-orange" aria-labelledby="cta-title">
  <slat-sea aria-hidden="true"></slat-sea>
  <div class="container cta__inner">
    <h2 id="cta-title" class="cta__title">{title}</h2>
    <p class="cta__text">{textParts.map((part, i) => (i % 2 ? <span class="cta__nowrap">{part}</span> : part))}</p>
    <div class="cta__actions">
      <Button href={demoHref} variant="dark" size="lg" arrow>Book a live demo</Button>
    </div>
  </div>
</section>

<script>
  import '../../scripts/slat-sea';
</script>

<style>
  .cta {
    position: relative;
    overflow: hidden;
    padding-block: clamp(72px, 8vw, 120px);
  }

  /* The slat wall (slat-sea.ts): decoration under the content, out of the way of clicks. It fades in once drawn. */
  slat-sea {
    position: absolute;
    inset: 0;
    pointer-events: none;
  }

  slat-sea :global(.slats__layer) {
    position: absolute;
    inset: 0;
    opacity: 0;
    transition: opacity 0.9s ease;
  }

  slat-sea :global(.slats__layer.is-on) {
    opacity: 1;
  }

  slat-sea :global(canvas) {
    display: block;
    width: 100%;
    height: 100%;
  }

  @media (prefers-reduced-motion: reduce) {
    slat-sea :global(.slats__layer) {
      transition: none;
    }
  }

  /* Phones: the text fills the band, so the band runs on below it and the sea has open water to roll in. */
  @media (max-width: 719px) {
    .cta {
      padding-bottom: clamp(112px, 30vw, 128px);
    }
  }

  .cta__inner {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  /* Same step as every section H2, so the closing band reads as part of the page. */
  .cta__title {
    max-width: 15ch;
    font-size: var(--step-h2);
    line-height: 1.04;
    letter-spacing: -0.035em;
    font-weight: 700;
    text-wrap: balance;
  }

  /* One measure for every page's lead, so the band reads the same everywhere. */
  .cta__text {
    max-width: 46ch;
    font-size: var(--step-lead);
    font-weight: 500;
    text-wrap: pretty;
  }

  .cta__nowrap {
    white-space: nowrap;
  }

  .cta__actions {
    display: flex;
  }

  /* Phones: the booking button takes the row. */
  @media (max-width: 479px) {
    .cta__actions > :global(.btn--dark) {
      flex: 1;
    }
  }
</style>
